    <Script type="xscript5.0"><![CDATA[/*************************   Program description   ****************************
 File Name      : QSEAR_35_CONT_COLOR_CHART_N
 File Desc.     : 내용물별 원료 색차 - 차트(내용물(N)개 조회)
 Author         : SMKWON
 Create Date    : 2024/01/25
 Change History :
*******************************************************************************/

/*****************************
 *  공통 Script Include      *
 ****************************/
include "js::QMS_COMMON.xjs"

/*****************************
 *  화면 변수 선언부       *
 ****************************/
this.vsSaveflag;
this.vsRow;
this.vsChartCnt;
/***************************************************************************************************
 *                                   화면 공통 Event 처리 부분                                    *
 ***************************************************************************************************/
this.Form_onload = function(obj:Form, e:nexacro.LoadEventInfo)
{
	this.gfn_FormLoadSetting(obj ); 
	this.gfn_GridSetting(this.Div_CONT);
	this.gfn_QmsCommL3AuthChk(true , "1");

	this.ds_Param.setColumn(0,"PLANT", application.g_ds_Session.getColumn(0,"PLANT"));	
	this.ds_Param_chart.setColumn(0,"PLANT", application.g_ds_Session.getColumn(0,"PLANT"));
	this.fn_Find("find_code_table",this.ds_Param);	
	
	this.vscrollbar.set_pos(0);
	this.Div_CHART.hscrollbar.set_pos(0);
	
}

this.fn_Search = function(sExpandSearch) {
	var addQueryString="";
	//확장검색
	if( sExpandSearch == "ok" ){		
		if(application.g_ds_Param.rowcount > 0){
			var addString = this.gfn_dsParamQuarryStr(application.g_ds_Param);
			addQueryString = "(" + addString + ")";	
		}
	}
	
	this.ds_Param.setColumn(0,"ADDQUEERYSTRING", addQueryString);
	this.ds_Param.setColumn(0,"ADDQUEERYSTRING2", addQueryString);
	this.fn_Find("find_main",this.ds_Param);	// 내용물 리스트 조회
}
// 줄 추가 
this.Div_CONT_btnAdd_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	this.ds_MAIN_MATR.set_enableevent(false);
		
	var row = this.ds_MAIN_MATR.addRow();	
	this.ds_MAIN_MATR.setColumn(row,"CUD_TYPE","C");
	this.ds_MAIN_MATR.setColumn(row,"BTN_CANCEL","삭제");
	
	this.ds_MAIN_MATR.set_enableevent(true);
}

// 자재리스트 Clear
this.Div_CONT_btnClear_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	this.ds_CODE_TABLE_SAVE.set_enableevent(false);
	this.ds_CODE_TABLE_SAVE.setColumn(0,"CODE", "");		 	// CODE 
	this.ds_CODE_TABLE_SAVE.setColumn(0,"CONT_CNT", "");		// 건수 
	this.ds_CODE_TABLE_SAVE.setColumn(0,"ADDQUEERYSTRING",""); 	// addQueryString
	this.ds_CODE_TABLE_SAVE.setColumn(0,"CMNT",""); 			// CMNT
	this.ds_CODE_TABLE_SAVE.set_enableevent(true);
	
	this.ds_MAIN_MATR.set_enableevent(false);
	this.ds_MAIN_MATR.clearData();
	this.ds_MAIN_MATR.set_enableevent(true);
	
	this.fn_ChartClear("White");
	this.fn_ChartClear("Yellow");
	this.fn_ChartClear("Red");
	this.fn_ChartClear("Black");
}
// Clear
this.fn_ChartClear = function(sCOLOR){


	var stringLAB = "L/A/B/";
	var arrLAB = new Array();
		arrLAB = stringLAB.split("/"); 
		
	for(var a=0; a< arrLAB.length-1; a++){ 
		this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_MATR.clearData();
		this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_rChart.clearData();
		this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"Y_MIN","");
		this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"Y_MAX","");
		this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"X_MIN","");
		this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"X_MAX","");
		this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].btnChange_onclick();
	}

}

// 자재코드 1건 조회
this.ds_MAIN_MATR_oncolumnchanged = function(obj:Dataset, e:nexacro.DSColChangeEventInfo)
{
	if(e.columnid=="MATR_CODE"){
		if( this.gfn_Length(e.newvalue)==7){
			this.vsRow =e.row;
			this.ds_Param.setColumn(0,"ADDQUEERYSTRING",  "(^" + e.newvalue + "^)");
			this.ds_Param.setColumn(0,"ADDQUEERYSTRING2", "(^" + e.newvalue + "^)");
			this.fn_Find("find_matr",this.ds_Param);	// 내용물 리스트 조회
		}
	}
}



// chart 조회
this.button1_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	if( this.ds_MAIN_MATR.rowcount==0) return;
	
	var addString= "";
	for(var i=0; i<this.ds_MAIN_MATR.rowcount; i++)
	{ 
		if(!this.gfn_IsEmpty(this.ds_MAIN_MATR.getColumn(i,"MATR_CODE")) ){
			if(i==0){
				addString = "^" + this.gfn_Trim( this.ds_MAIN_MATR.getColumn(i,"MATR_CODE") ) + "^";
			}else{
				addString = addString + ",^" + this.gfn_Trim( this.ds_MAIN_MATR.getColumn(i,"MATR_CODE") )+ "^";
			}
		}
	}
	this.ds_Param_chart.setColumn(0,"ADDQUEERYSTRING",addString); // addQueryString
	this.ds_Param_chart.setColumn(0,"ADDQUEERYSTRING2",addString); // addQueryString
	
	this.vsChartCnt=0;
	this.fn_Find("find_main_chart", this.ds_Param_chart);
	this.fn_Find("find_main_chart_line", this.ds_Param_chart);
	this.fn_Find("find_chart_minmax", this.ds_Param_chart);
}




/***************************************************************************************************
 *								div_horizontalBar_move_ondrag										*
 ***************************************************************************************************/
this.f_drag;
this.div_verticalBar_move_ondrag = function(obj:ImageViewer, e:nexacro.DragEventInfo)
{
	this.currArrange = "vertical";
	
	this.nMoveX = nexacro.toNumber(obj.left);
	this.nMoveY = nexacro.toNumber(obj.top);

	this.f_drag = true;
	return true;
}

this.From_ondragmove = function(obj:Form, e:nexacro.DragEventInfo)
{
	if(!this.f_drag) return;

	var nPosX, nPosY;

	if ( e.button == "lbutton" ){	
		if( this.currArrange == "vertical" ){
			nPosX = nexacro.toNumber(e.clientX);
		}
		
		try{
			if( this.currArrange == "vertical" ){
				this.div_verticalBar_move.setOffsetLeft(nPosX);
			}
		}
		catch(ex){
		}
	}
}
this.From_onlbuttonup = function(obj:Form, e:nexacro.MouseEventInfo)
{
	if(!this.f_drag) return;
	
	this.f_drag = false;

	var nMoveValue;
	var sDivObjLeft = this.Div_CONT;
	var sDivObjRight = this.Div_CHART;
	
	if ( this.currArrange == "vertical" ){		
		this.div_verticalBar_move.setOffsetLeft(e.clientX);
		nMoveValue = nexacro.toNumber(nexacro.toNumber(this.div_verticalBar_move.left) - this.nMoveX);

		sDivObjLeft.set_width(nexacro.toNumber(sDivObjLeft.width) + nMoveValue);	
		sDivObjRight.set_left(nexacro.toNumber(sDivObjRight.left) + nMoveValue);
		//sDivObjRight2.set_left(nexacro.toNumber(sDivObjRight2.left) + nMoveValue);
		
		if(this.div_verticalBar_move.getOffsetLeft(e.clientX) <= this.getOffsetLeft()){
			this.div_verticalBar_move.set_left(this.getOffsetLeft()+10);
			sDivObjLeft.setOffsetRight(this.div_verticalBar_move.getOffsetLeft()-3);
			sDivObjRight.setOffsetLeft(this.div_verticalBar_move.getOffsetLeft()+8);
			//sDivObjRight2.setOffsetLeft(this.div_verticalBar_move.getOffsetLeft()+8);
		}
		else if (this.div_verticalBar_move.getOffsetRight(e.clientX) >= this.getOffsetRight()){
			this.div_verticalBar_move.setOffsetLeft(this.Tab.tabpage1.getOffsetRight()-10);
			sDivObjLeft.setOffsetRight(this.div_verticalBar_move.getOffsetLeft()-3);
			sDivObjRight.setOffsetLeft(this.div_verticalBar_move.getOffsetLeft()+8);
			//sDivObjRight2.setOffsetLeft(this.div_verticalBar_move.getOffsetLeft()+8);
		}
	}
	
}
/***************************************************************************************************
 *                                 팝업 Callback                               *
 ***************************************************************************************************/
this.fn_popupAfter = function(sPopupId, Variant)
{
	// 반환받은 문자열데이타 형변환(String, Array, Object) 처리
	var rtn = this.gfn_GetPopupRtn();
	
	switch(sPopupId){
		
		case "comExpandSearch": 
			if(rtn=="ok"){
				if(application.g_ds_Param.rowcount > 0){
					this.fn_Search("ok");
				}
			}
		break; 
	}
}

/***************************************************************************************************
 *                                 화면 공통 Function 처리 부분                                   *
 ***************************************************************************************************/
// Transaction 후 처리 해야 할 내용!
this.fn_CallBack = function (sSvcID, nErrorCode, sErrorMsg) {
	

	if(!this.gfn_CheckTranResult(this, sSvcID, nErrorCode, sErrorMsg)) return;	
	switch(this.gfn_GetSvcId(sSvcID)) {//get service id 
		 
		case "find_main_chart":
			this.vsChartCnt++;
			this.fn_ChartDataMerge();
			break;
		case "find_main_chart_line":
			this.vsChartCnt++;
			this.fn_ChartDataMerge();
			break;
		case "find_chart_minmax":
			this.vsChartCnt++;
			this.fn_ChartDataMerge();
			break;
		 
	
		case "find_matr":
			if(this.ds_MATR.rowcount==0){
				this.ds_MAIN_MATR.setColumn(this.vsRow,"MATR_NAME", "자재코드를 정확하게 입력하세요");
			}else{
				this.ds_MAIN_MATR.set_enableevent(false);
				this.ds_MAIN_MATR.setColumn(this.vsRow,"PLANT", this.ds_MATR.getColumn(0,"PLANT"));
				this.ds_MAIN_MATR.setColumn(this.vsRow,"MATR_NAME", this.ds_MATR.getColumn(0,"MATR_NAME"));
				this.ds_MAIN_MATR.setColumn(this.vsRow,"BATCH_CNT", this.ds_MATR.getColumn(0,"BATCH_CNT"));
				this.ds_MAIN_MATR.setColumn(this.vsRow,"CUD_TYPE","");
				this.ds_MAIN_MATR.set_enableevent(true);
			}
			break;
			
		case "find_code_table":
			if( this.vsSaveflag == true){
				if( this.gfn_IsEmpty(this.ds_CODE_TABLE_SAVE.getColumn(0,"CODE")) ){
					var row = this.ds_CODE_TABLE.rowcount-1;
					this.ds_CODE_TABLE_SAVE.setColumn(0,"CODE", this.ds_CODE_TABLE.getColumn(row,"CODE"));
				}
			}
			this.vsSaveflag = false;
			break;
		
		case "save_code_table":
			this.vsSaveflag = true;
			this.fn_Find("find_code_table",this.ds_Param);
			break;
		case "delete_code_table":
			this.fn_Find("find_code_table",this.ds_Param);
			this.Div_CONT_btn_ContList_onclick();
			break;
		default:
			break;
	}
}
/***************************************************************************************************
 *                                사용자 정의  Function 처리 부분                                *
 ***************************************************************************************************/

//조회
this.fn_Find = function(sTransition, oDsSet)
{
	this.gfn_DsSetTransaction(this, sTransition, this.ds_Service, this.gfn_GetDatasetToPram(this,oDsSet));
}
//저장
this.fn_Save = function(sTransition, sArgument){
	this.gfn_DsSetTransaction(this, sTransition, this.ds_Service, this.gfn_GetTranInfo("CHNG_ID|PROC_ID|LANG_TYPE|PLANT|PRD_CI")+sArgument);
}


//확장검색 팝업창
this.btnExpandSearch_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
	this.gfn_OpenPopup("comExpandSearch","COMMON::comExpandSearch.xfdl",{title: "내용물코드"},"fn_popupAfter");
}
 
// 내용물 리스트 저장   
this.Div_CONT_btn_Save_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{

	if( this.ds_MAIN_MATR.rowcount==0){
		// 1118 내용물 코드 정보가 없습니다..
		this.gfn_Message("1118", "OK");
		return;
	}
	
	// 코멘트 필수입력
	if(this.gfn_IsEmpty(this.ds_CODE_TABLE_SAVE.getColumn(0,"CMNT")) ){
		// 5819 {@}를 입력하여 주십시오.
		this.gfn_Message("5045", "OK", "코멘트");
		this.Div_CONT.txt_CMNT.setFocus();
		return;
	}
	
	

	var addString= "";
	for(var i=0; i<this.ds_MAIN_MATR.rowcount; i++)
	{ 
		if(!this.gfn_IsEmpty(this.ds_MAIN_MATR.getColumn(i,"MATR_CODE")) ){
			if(i==0){
				addString = "^" + this.gfn_Trim( this.ds_MAIN_MATR.getColumn(i,"MATR_CODE") ) + "^";
			}else{
				addString = addString + ",^" + this.gfn_Trim( this.ds_MAIN_MATR.getColumn(i,"MATR_CODE") )+ "^";
			}
		}
	}
	
	var sCONT_CNT = this.gfn_Trim(this.ds_MAIN_MATR.getColumn(0,"MATR_CODE")) +"외 "+ this.gfn_Trim(this.ds_MAIN_MATR.rowcount-1)+"건";
	
	this.ds_CODE_TABLE_SAVE.setColumn(0,"CONT_CNT", sCONT_CNT);		 // 건수 
	this.ds_CODE_TABLE_SAVE.setColumn(0,"ADDQUEERYSTRING",addString); // addQueryString
	this.fn_Save("save_code_table");
}
// 내용물코드 리스트
this.Div_CONT_grd_MAIN_MATR_oncellclick = function(obj:Grid, e:nexacro.GridClickEventInfo)
{
	// 제거 
	if( this.gfn_getColId(obj, e.col) == "BTN_CANCEL"){
		
		this.ds_MAIN_MATR.set_enableevent(false);
		this.ds_MAIN_MATR.deleteRow(e.row);
		this.ds_MAIN_MATR.set_enableevent(true);
		
		var addString= "";
		for(var i=0; i<this.ds_MAIN_MATR.rowcount; i++)
		{ 
			if(!this.gfn_IsEmpty(this.ds_MAIN_MATR.getColumn(i,"MATR_CODE")) ){
				if(i==0){
					addString = "^" + this.gfn_Trim( this.ds_MAIN_MATR.getColumn(i,"MATR_CODE") ) + "^";
				}else{
					addString = addString + ",^" + this.gfn_Trim( this.ds_MAIN_MATR.getColumn(i,"MATR_CODE") )+ "^";
				}
			}
		}
		this.ds_CODE_TABLE_SAVE.setColumn(0,"ADDQUERYSTRING",addString); // addQueryString
	}
}

// 저장된 리스트 팝업창 닫기 
this.Pdiv_CONT_btnClose_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	this.Pdiv_CONT.closePopup();
}

// 저장된 리스트 
this.Div_CONT_btn_ContList_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{

	//팝업띄움
	this.Pdiv_CONT.trackPopupByComponent(this.Div_CONT.grd_MAIN_MATR, 510, 0);		
	//팝업창에 포커스
	this.Pdiv_CONT.grd_CODE_TABLE.setFocus();
	
}
// 저장된 리스트 삭제
this.Pdiv_CONT_btn_Del_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	
	var row1 = this.ds_CODE_TABLE.findRow("CHK", "1"); 
	if(row1==-1){
		//5477 삭제할 항목을 선택하여 주십시오.
		this.gfn_Message("5477", "OK");
		this.Div_CONT_btn_ContList_onclick();
		return;
	} 
	
	// 1302 선택된 데이터를 삭제 하시겠습니까?
	if(this.gfn_Message("1302","YESNO")){
		this.fn_Save("delete_code_table");
	}else{		
		this.Div_CONT_btn_ContList_onclick();
	}
}
// 저장된 리스트 선택 
this.Pdiv_CONT_grd_CODE_TABLE_oncelldblclick = function(obj:Grid, e:nexacro.GridClickEventInfo)
{
	this.ds_CODE_TABLE_SAVE.setColumn(0,"CODE", this.ds_CODE_TABLE.getColumn(e.row, "CODE"));
	this.ds_CODE_TABLE_SAVE.setColumn(0,"CONT_CNT", this.ds_CODE_TABLE.getColumn(e.row, "CONT_CNT"));
	this.ds_CODE_TABLE_SAVE.setColumn(0,"ADDQUEERYSTRING", this.ds_CODE_TABLE.getColumn(e.row, "ADDQUEERYSTRING"));
	this.ds_CODE_TABLE_SAVE.setColumn(0,"CMNT", this.ds_CODE_TABLE.getColumn(e.row, "CMNT"));
	
	
	this.ds_Param.setColumn(0,"ADDQUEERYSTRING",  "(" +this.ds_CODE_TABLE.getColumn(e.row, "ADDQUEERYSTRING")+")");
	this.ds_Param.setColumn(0,"ADDQUEERYSTRING2", "(" +this.ds_CODE_TABLE.getColumn(e.row, "ADDQUEERYSTRING")+")");
	this.fn_Find("find_main",this.ds_Param);	 
}
// 저장된 리스트 복사(신규추가)
this.Pdiv_CONT_grd_CODE_TABLE_onlbuttonup = function(obj:Grid, e:nexacro.GridMouseEventInfo)
{
	if( this.gfn_getColId(obj, e.col) == "BTN_COPY"){
		this.ds_CODE_TABLE_SAVE.setColumn(0,"CODE", "");
		this.ds_CODE_TABLE_SAVE.setColumn(0,"CONT_CNT", this.ds_CODE_TABLE.getColumn(e.row, "CONT_CNT"));
		this.ds_CODE_TABLE_SAVE.setColumn(0,"ADDQUEERYSTRING", this.ds_CODE_TABLE.getColumn(e.row, "ADDQUEERYSTRING"));
		this.ds_CODE_TABLE_SAVE.setColumn(0,"CMNT", this.ds_CODE_TABLE.getColumn(e.row, "CMNT"));
		
		this.ds_Param.setColumn(0,"ADDQUEERYSTRING",  "(" +this.ds_CODE_TABLE.getColumn(e.row, "ADDQUEERYSTRING")+")");
		this.ds_Param.setColumn(0,"ADDQUEERYSTRING2", "(" +this.ds_CODE_TABLE.getColumn(e.row, "ADDQUEERYSTRING")+")");
		this.fn_Find("find_main",this.ds_Param);
		this.fn_Save("save_code_table");
	}
}

this.titleName_onclick = function(obj:Static, e:nexacro.ClickEventInfo)
{
	if(this.Grid03.visible){ 
		this.Grid02.set_visible(false);
		this.Grid03.set_visible(false);
	}else{ 
		this.Grid02.set_visible(true);
		this.Grid03.set_visible(true);
	}
}
this.btn_Left_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	this.div_verticalBar_move.setOffsetLeft(10);
	this.Div_CONT.setOffsetRight(10);
	this.Div_CHART.setOffsetLeft(20);
	this.txt_CMNT.set_visible(true);
}

this.btn_Right_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	this.div_verticalBar_move.setOffsetLeft(540);
	this.Div_CONT.setOffsetRight(535);
	this.Div_CHART.setOffsetLeft(550);
	this.txt_CMNT.set_visible(false);
}



this.fn_ChartDataMerge = function(){
	if(this.vsChartCnt==3){
		 
		this.ds_rChart.set_enableevent(false);
		this.ds_rChart.clearData();
		this.ds_rChart.appendData(this.ds_MAIN_CHART);
		
		var sSTAR_CI="";
		var sCOLOR_CI="";
		var sRANKNUM="";
		var sfindRow=-1;
		for(var i=0; i<this.ds_MAIN_CHART_LINE.rowcount; i++)
		{ 
			sSTAR_CI = this.gfn_Trim(this.ds_MAIN_CHART_LINE.getColumn(i, "STAR_CI"));
			sCOLOR_CI = this.gfn_Trim(this.ds_MAIN_CHART_LINE.getColumn(i, "COLOR_CI"));
			sRANKNUM = this.gfn_Trim(this.ds_MAIN_CHART_LINE.getColumn(i, "RANKNUM"));
			
			sfindRow= this.ds_rChart.findRowExpr("STAR_CI=='"+sSTAR_CI+"' && COLOR_CI=='"+sCOLOR_CI+"' && RANKNUM=='"+sRANKNUM+"'");
			
			if( sfindRow>-1){
				for(var a=1; a<100; a++){
					this.ds_rChart.setColumn(sfindRow, "X"+a, this.ds_MAIN_CHART_LINE.getColumn(i, "X"+a));
					this.ds_rChart.setColumn(sfindRow, "Y"+a, this.ds_MAIN_CHART_LINE.getColumn(i, "Y"+a));
					this.ds_rChart.setColumn(sfindRow, "CONT_CODE"+a, this.ds_MAIN_CHART_LINE.getColumn(i, "CONT_CODE"+a));
				}
			}
		}
		this.ds_rChart.set_enableevent(true);
	}
	
					
		var stringCOLOR = "White/Yellow/Red/Black/";
		var arrCOLOR = new Array();
			arrCOLOR = stringCOLOR.split("/"); 
		
		for(var i=0; i< arrCOLOR.length-1; i++){ 
			var sCOLOR = arrCOLOR[i];
			var sCOLOR_CI = this.gfn_Left(arrCOLOR[i],1);		
	
			var stringLAB = "L/A/B/";
			var arrLAB = new Array();
				arrLAB = stringLAB.split("/"); 
				

			for(var a=0; a< arrLAB.length-1; a++){ 
				var sSTAR_CI = arrLAB[a];
				
				var sMinMaxRow = this.ds_MAIN_CHART_MINMAX.findRowExpr("STAR_CI=='"+sSTAR_CI+"' && COLOR_CI=='"+sCOLOR_CI+"'");
				
				if(sMinMaxRow>-1){
					var nXMin = nexacro.round(nexacro.toNumber(this.ds_MAIN_CHART_MINMAX.getColumn(sMinMaxRow,"XMIN"))-0.5,2);
					var nXMax = nexacro.round(nexacro.toNumber(this.ds_MAIN_CHART_MINMAX.getColumn(sMinMaxRow,"XMAX"))+0.5,2);
					if(nXMin<0){
						nXMin=0;
					}
					var nYMin = nexacro.round(nexacro.toNumber(this.ds_MAIN_CHART_MINMAX.getColumn(sMinMaxRow,"YMIN"))-3,2);
					var nYMax = nexacro.round(nexacro.toNumber(this.ds_MAIN_CHART_MINMAX.getColumn(sMinMaxRow,"YMAX"))+3,2);
					
					
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.set_enableevent(false);

					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"CHART_TITLE",sCOLOR);
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"SUB_TITLE",arrLAB[a]+"*");
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"Y_MIN",nYMin);
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"Y_MAX",nYMax);
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"X_MIN",nXMin);
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,"X_MAX",nXMax);
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.set_enableevent(true);
					
					
					this.ds_rChart.set_enableevent(false);
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_rChart.set_enableevent(false);
					
					this.ds_rChart.filter("STAR_CI=='"+sSTAR_CI+"' && COLOR_CI=='"+sCOLOR_CI+"'");
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_rChart.copyData(this.ds_rChart, true);	
				
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_rChart.set_enableevent(true);
					this.ds_rChart.set_enableevent(true);
					
					
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_MATR.set_enableevent(false);
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_MATR.clearData();
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_MATR.copyData(this.ds_MAIN_MATR);
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_MATR.set_enableevent(true);
					
					this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].btnChange_onclick();
				}
			}
		}		
	this.ds_rChart.set_enableevent(false);
	this.ds_rChart.filter("");
	this.ds_rChart.set_enableevent(true);		
}

// 다른색상의 동일색차(L,a,b) Y축 변화 
this.fn_ChartSetting_LAB = function(sChartName, sColumId, eValue){

	var arrStr = sChartName.split("_");
	var sCOLOR = arrStr[1];
	var sLAB   = arrStr[2];
	
	var stringCOLOR = "White/Yellow/Red/Black/";
	var arrCOLOR = new Array();
		arrCOLOR = stringCOLOR.split("/"); 
	
	for(var i=0; i< arrCOLOR.length-1; i++){ 
		if( sCOLOR != arrCOLOR[i]){
			this["Div_CHART"]["Div_"+arrCOLOR[i]+"_"+sLAB].ds_ChartSet.set_enableevent(false);
			this["Div_CHART"]["Div_"+arrCOLOR[i]+"_"+sLAB].ds_ChartSet.setColumn(0,sColumId,eValue);
			this["Div_CHART"]["Div_"+arrCOLOR[i]+"_"+sLAB].ds_ChartSet.set_enableevent(true);
		}
		this["Div_CHART"]["Div_"+arrCOLOR[i]+"_"+sLAB].btnChange_onclick();
	}
}


// 동일 color(White,Yellow,Red,Black) X축 변화 
this.fn_ChartSetting_COLOR = function(sChartName, sColumId, eValue){
	var arrStr = sChartName.split("_");
	var sCOLOR = arrStr[1];
	var sLAB   = arrStr[2];	

	var stringLAB = "L/A/B/";
	var arrLAB = new Array();
		arrLAB = stringLAB.split("/"); 		

	for(var a=0; a< arrLAB.length-1; a++){  
		if( sLAB != arrLAB[a]){
			this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.set_enableevent(false);
			this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.setColumn(0,sColumId,eValue);
			this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].ds_ChartSet.set_enableevent(true);
		}
		this["Div_CHART"]["Div_"+sCOLOR+"_"+arrLAB[a]].btnChange_onclick();
	}
}]]></Script>
  </Form>
