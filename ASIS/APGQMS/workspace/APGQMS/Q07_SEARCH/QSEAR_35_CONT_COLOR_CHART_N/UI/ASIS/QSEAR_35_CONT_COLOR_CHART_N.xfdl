                      <Cell col="3" text="bind:BATCH_CNT"/>
                      <Cell col="4" displaytype="button" edittype="button" text="bind:BTN_CANCEL"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
              <Edit id="txt_CONT_CNT" taborder="6" left="63" top="3" width="100" height="20" readonly="false" enable="false"/>
