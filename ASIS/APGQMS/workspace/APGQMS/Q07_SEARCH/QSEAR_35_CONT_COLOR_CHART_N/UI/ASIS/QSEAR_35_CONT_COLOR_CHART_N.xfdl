              <Edit id="txt_CODE" taborder="2" onkeyup="txt_Search_onkeyup" left="3" top="3" width="57" height="20" readonly="false" enable="false"/>
              <TextArea id="txt_CMNT" taborder="3" left="165" top="3" height="20" right="48" style="padding:0 4 0 4;"/>
              <Button id="btnExpandSearch" taborder="4" text="확장검색" onclick="btnExpandSearch_onclick" left="0" top="30" width="60" height="22"/>
              <Grid id="grd_MAIN_MATR" taborder="5" binddataset="ds_MAIN_MATR" left="0" top="55" oncellclick="Div_CONT_grd_MAIN_MATR_oncellclick" autofittype="col" right="2" bottom="20">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="40" band="left"/>
                      <Column size="70" band="left"/>
                      <Column size="314"/>
                      <Column size="40"/>
                      <Column size="40"/>
                    </Columns>
                    <Rows>
                      <Row size="48" band="head"/>
                      <Row size="24"/>
                    </Rows>
                    <Band id="head">
                      <Cell/>
                      <Cell col="1" text="내용물코드"/>
                      <Cell col="2" text="내용물명"/>
                      <Cell col="3" text="로트&#13;&#10;건수"/>
                      <Cell col="4" text="삭제"/>
                    </Band>
                    <Band id="body">
                      <Cell celltype="head" expr="currow+1"/>
                      <Cell col="1" edittype="expr:(CUD_TYPE=='C')?'normal':'none'" style="background:EXPR((CUD_TYPE=='C')?'#dbebff':'');background2:EXPR((CUD_TYPE=='C')?'#dbebff':'');selectbackground:EXPR((CUD_TYPE=='C')?'#dbebff':'');" text="bind:MATR_CODE"/>
