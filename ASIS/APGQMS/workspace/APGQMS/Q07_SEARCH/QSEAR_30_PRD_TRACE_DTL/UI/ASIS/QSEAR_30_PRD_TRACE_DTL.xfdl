/***************************************************************************************************
 *									button4_onclick( Excel Export )									*
 ***************************************************************************************************/
this.button4_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
	//2019/06/28 JNKSYSTEM KHG 엑셀저장시 모든 그리드 포함저장
	if( this.Tab_MATR_CI.tabindex == 0){
	// 완제품
		this.fn_QmsExportExcel(this.Div_FER1.grd_FER1, this.Div_FER1.grd_HAL1_2, this.Div_FER1.grd_HAL3, this.Div_FER1.grd_ROH6);

	
	}else if( this.Tab_MATR_CI.tabindex == 1){
	// 내용물
		this.fn_QmsExportExcel(this.Div_HAL3.grd_HAL3, this.Div_FER1.grd_FER1, this.Div_FER1.grd_HAL1_2, this.Div_FER1.grd_ROH6);		
	}else if( this.Tab_MATR_CI.tabindex == 2){
	// 원료
		this.fn_QmsExportExcel(this.Div_ROH6.grd_ROH6, this.Div_HAL3.grd_HAL3, this.Div_FER1.grd_FER1, this.Div_FER1.grd_HAL1_2);
	}
	
}
//2019/06/28 JNKSYSTEM KHG 엑셀저장시
this.fn_QmsExportExcel = function (objComp:Grid, objComp2:Grid, objComp3:Grid, objComp4:Grid){

	if(objComp == undefined || objComp.binddataset == null) return;
	
	var objDs =  eval("this."+objComp.binddataset);
	var objDs2 =  eval("this."+objComp2.binddataset);
	var objDs3 =  eval("this."+objComp3.binddataset);
	var objDs4 =  eval("this."+objComp4.binddataset);
	
	
	if(!(objComp instanceof Grid)){
		return false;
	}
	var sFormat = objComp.getCurFormatString();	
	var sFormat2 = objComp2.getCurFormatString();	
	var sFormat3 = objComp3.getCurFormatString();	
	var sFormat4 = objComp4.getCurFormatString();	
	
	for(var i = objComp.getCellCount("body") -1 ; i >=0 ; i--){
		if( objComp.getFormatColSize(i) <= 0){
			if(this.gfn_getColId(objComp, i) != "KEY_NO")
				objComp.deleteContentsCol(i);
		}				
	}
	
	for(var i = objComp2.getCellCount("body") -1 ; i >=0 ; i--){
		if( objComp2.getFormatColSize(i) <= 0){
			if(this.gfn_getColId(objComp2, i) != "KEY_NO")
				objComp2.deleteContentsCol(i);
		}				
	}
	
	for(var i = objComp3.getCellCount("body") -1 ; i >=0 ; i--){
		if( objComp3.getFormatColSize(i) <= 0){
			if(this.gfn_getColId(objComp3, i) != "KEY_NO")
				objComp3.deleteContentsCol(i);
		}				
	}
	
	for(var i = objComp4.getCellCount("body") -1 ; i >=0 ; i--){
		if( objComp4.getFormatColSize(i) <= 0){
			if(this.gfn_getColId(objComp4, i) != "KEY_NO")
				objComp4.deleteContentsCol(i);
		}				
	}
	var sGrid = objComp.name;

	this.ExcelExportObject = null;	
	this.ExcelExportObject = new ExcelExportObject("ExcelExportObject", this); 
	
	var ret = this.ExcelExportObject.addExportItem(nexacro.ExportItemTypes.GRID, objComp,this.excelsheet1 + "!A1","allband","allrecord","suppress","onlyvalue","none","color","both");
 	if(objDs2.rowcount != 0){
 		this.ExcelExportObject.addExportItem(nexacro.ExportItemTypes.GRID, objComp2,this.excelsheet2 + "!A1","allband","allrecord","suppress","onlyvalue","none","color","both");
	}
 	if(objDs3.rowcount != 0){
 		this.ExcelExportObject.addExportItem(nexacro.ExportItemTypes.GRID, objComp3,this.excelsheet3 + "!A1","allband","allrecord","suppress","onlyvalue","none","color","both");
	}
	if(objDs4.rowcount != 0){
 		this.ExcelExportObject.addExportItem(nexacro.ExportItemTypes.GRID, objComp4,this.excelsheet4 + "!A1","allband","allrecord","suppress","onlyvalue","none","color","both");
 	}
	
	
	objComp.set_formats(sFormat);
	
	if(objDs.rowcount > 0){
		this.ExcelExportObject.set_exportmessageprocess("");
		this.ExcelExportObject.set_exportuitype("exportprogress");
		this.ExcelExportObject.set_exporteventtype("itemrecord");
	}
	
    this.ExcelExportObject.set_exporttype(nexacro.ExportTypes.EXCEL2007);

	this.ExcelExportObject.set_exportfilename("ExcelExport"+sGrid);
	
    this.ExcelExportObject.set_exporturl(application.services["URL"].url  + "XExportImport");
    
    this.ExcelExportObject.exportData();
    

} 


this.chk_DATE_onchanged = function(obj:CheckBox, e:nexacro.CheckBoxChangeEventInfo)
{
	if( this.chk_DATE.value == true){
		this.calLOT_CREATE_DATE1.set_readonly(false);
		this.calLOT_CREATE_DATE2.set_readonly(false);
	}else{
		this.calLOT_CREATE_DATE1.set_readonly(true);
		this.calLOT_CREATE_DATE2.set_readonly(true);
	}
}


this.calLOT_CREATE_DATE1_onchanged = function(obj:Calendar, e:nexacro.ChangeEventInfo)
{
	if( this.calLOT_CREATE_DATE1.value > this.calLOT_CREATE_DATE2.value){
		this.calLOT_CREATE_DATE2.set_value(this.calLOT_CREATE_DATE1.value);
	}
}

this.calLOT_CREATE_DATE2_onchanged = function(obj:Calendar, e:nexacro.ChangeEventInfo)
{
	if( this.calLOT_CREATE_DATE1.value > this.calLOT_CREATE_DATE2.value){
		this.calLOT_CREATE_DATE1.set_value(this.calLOT_CREATE_DATE2.value);
	}
}
this.btnAllPrint_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
	this.ds_FER_PRT.clearData ();
	this.ds_PRT_RETURN.clearData();
	this.ds_FER_PRT.addRow ();
	this.ds_FER_PRT.copyRow (0,this.ds_FER1,this.ds_FER1.rowposition);

	var sSvcNm = "QSEAR_30_PRD_TRACE-service"; 
	var sTransition = "save_PRT_INSERT";              
	var sInDataSet  = "ds_FER_PRT=ds_FER_PRT";
	var sOutDataSet = "ds_PRT_RETURN=dsr_RetrunSeq";
	var sArgument =  this.gfn_ParamSetting("PLANT", 	application.g_ds_Session.getColumn(0,"PLANT")) 
					+this.gfn_ParamSetting("CHNG_ID", 	application.g_ds_Session.getColumn(0,"CHNG_ID")) 
					+this.gfn_ParamSetting("PROC_ID", 	application.g_ds_Session.getColumn(0,"PROC_ID"))
					+this.gfn_ParamSetting("PRD_CI", 	application.g_ds_Session.getColumn(0,"USER_PRD_CI")) 
					+this.gfn_ParamSetting("LANG_TYPE",	application.g_ds_Session.getColumn(0,"LANG_TYPE"))
					;
	this.gfn_Transaction(this, "save_PRT_INSERT", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack");
}
this.fn_PRT = function () {
	var tCnt = this.ds_PRT_RETURN.getColumn (0,"TOT_CNT");
	var strLangType = application.g_ds_Session.getColumn(0,"LANG_TYPE");
	if(this.gfn_IsEmpty(this.gfn_Trim(tCnt))) {
		this.gfn_Message("5902", "OK", strLangType);
		return;
	}	
	this.Pdiv_MSG.txt_msg.set_value (tCnt + "건의 성적서가 생성됩니다.\n\n모든 성적서의 생성이 완료될때까지 기다려주세요.\n\n출력물의 페이지 수를 확인하세요.");
	this.Pdiv_MSG.set_visible(true);
		
	if( strLangType == "KR"){
		var sFileName = "COMMON_REPORT_V02";
	}else if( strLangType == "US"){
		var sFileName = "COMMON_REPORT_EN_V02";
	}
	var sResultFileName="";
	var	sDirectPrint="";
	var sParam1 = this.ds_PRT_RETURN.getColumn(0,"PRT_SEQ");
		
	var sRandom = Math.random();
	var sParam = "FILENAME="+sFileName+"&RESULTFILENAME="+sResultFileName+"&PARAM1="+sParam1+"&DIRECTPRINT="+this.gfn_DeleteUndefine(sDirectPrint)+"&LANG_TYPE="+strLangType+"&sRandom=" + sRandom
	var rdUrl =application.services["URL"].url + "callReport.jsp?"+encodeURI(sParam);

	this.webRd01.set_url(rdUrl);
}
this.Pdiv_MSG_btn_OK_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
	this.Pdiv_MSG.set_visible(false);
}



