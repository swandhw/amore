    <Script type="xscript5.0"><![CDATA[/*************************   Program description   ****************************
 File Name      : QSEAR_30_PRD_TRACE
 File Desc.     : QSEAR_30_PRD_TRACE(제품추적조회)//QTSMR_91_MICRO_TRACE(미생물추적조회)
 Author         : SMKWON
 Create Date    : 2015/08/06
 Change History :
*******************************************************************************/

/*****************************
 *  공통 Script Include      *
 ****************************/
include "js::QMS_COMMON.xjs"

/*****************************
 *  화면 변수 선언부       *
 ****************************/
this.ViewPage = "";
this.gLevel = "";
this.pack_order = "";
this.pack_order_seq = "";

/***************************************************************************************************
 *                                   화면 공통 Event 처리 부분                                    *
 ***************************************************************************************************/
this.QSEAR_30_PRD_TRACE_onload = function(obj:Form, e:nexacro.LoadEventInfo)
{
	/***********************************************************************************************
	   name     : gfn_GridSetting(objForm, pSort, pKeyDown, pRbuttonDown, pSetFocus)
	   argument : Grid의 속성을 변경 할 Form ID, 그리드 Sort여부, 그리드Copy여부, 그리드팝업페뉴여부, 그리드포커스여부(엑셀)
	 ***********************************************************************************************/		
	 
}
this.fn_setLoading = function () {
	
	this.gfn_GridSetting(this,true,true,false,true);	
	
	// 화면 권한 체크 (버튼 활성,비활성 설정 // 4. 조회, 종료)
	this.gfn_QmsCommL3AuthChk(true , "1");
	this.lab_TEST_RESULT.set_text("");
	
 	//제2 뷰티동 권한 정보를 가져온다. (T)
	this.gLevel = application.g_ds_Session.getColumn(0, "USER_LEVEL").substr(0, 1);
	var strPlant = application.g_ds_Session.getColumn(0,"PLANT");

	
	//제1뷰티와 제2뷰티는 뷰티사업장에서만 보여준다.
	if(strPlant != '1110' && strPlant != 'CN20'){
		this.static_authprd.set_visible(false);
		this.cmb_AuthPrdCI.set_visible(false);
	}	

	//감사모드
	var sSvcNm = "QMS_COMM_CODE_TABLE-service"; 
 	var sTransition = "find";              
 	var sInDataSet  = "";
 	var sOutDataSet = "ds_QMS51=dsr_SearchListResult";
 	var sArgument =  this.gfn_ParamSetting("CODE_TABLE_ID", "QMS51")
					+this.gfn_ParamSetting("HIGH_CODE", strPlant) ;					
 	this.gfn_Transaction(this, "find_AUTHORITY", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack",false,false,false);	
 	
	// ds_AUTHORITY_PAGE :: 화면권한
  	var sSvcNm = "QMS_COMM_CODE_TABLE-service"; 
 	var sTransition = "find";              
 	var sInDataSet  = "";
 	var sOutDataSet = "ds_QMS52=dsr_SearchListResult";
 	var sArgument =  this.gfn_ParamSetting("CODE_TABLE_ID", "QMS52")
					+this.gfn_ParamSetting("HIGH_CODE", "") ;
 	this.gfn_Transaction(this, "find_AUTHORITY_PAGE", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack");
	//end 감사모드
	

	//Calendar 셋팅
	this.calLOT_CREATE_DATE1.set_value(this.gfn_Today());
	this.calLOT_CREATE_DATE2.set_value(this.gfn_Today()); 
	
  	// ds_JUDG :: 전체 판정 콤보
  	var sSvcNm = "QMS_COMM_CODE_LANG-service"; 
 	var sTransition = "find";              
 	var sInDataSet  = "";
 	var sOutDataSet = "ds_JUDG=dsr_SearchListResult";
 	var sArgument =  this.gfn_ParamSetting("CODE_TABLE_ID", "LIM08")
					+this.gfn_ParamSetting("HIGH_CODE", "") 
					+this.gfn_ParamSetting("LANG_TYPE", 		application.g_ds_Session.getColumn(0,"LANG_TYPE"))
					+this.gfn_ParamSetting("ADDQUEERYSTRING",	"")
					;					
 	this.gfn_Transaction(this, "find_JUDG", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack");

   	// 제2뷰티동 정보
  	var sSvcNm = "QMS_COMM_CODE_LANG-service"; 
 	var sTransition = "find";              
 	var sInDataSet  = "";
 	var sOutDataSet = "ds_AuthPrdCI=dsr_SearchListResult";
 	var sArgument =  this.gfn_ParamSetting("CODE_TABLE_ID", "QMS70")
					+this.gfn_ParamSetting("HIGH_CODE", "") 
					+this.gfn_ParamSetting("LANG_TYPE", application.g_ds_Session.getColumn(0,"LANG_TYPE"))
					+this.gfn_ParamSetting("ADDQUEERYSTRING", "")	
					;
					
 	this.gfn_Transaction(this, "AUTHPRD", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack");		
	
 	
	this.ViewPage = this.name;
	
	//제품추적조회
	if(this.ViewPage=="QSEAR_30_PRD_TRACE")
	{
	
