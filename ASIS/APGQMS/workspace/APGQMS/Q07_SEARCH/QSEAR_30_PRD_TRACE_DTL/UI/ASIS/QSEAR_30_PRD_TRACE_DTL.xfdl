/***************************************************************************************************
 *								Tab_MATR_CI_onchanged(  TAB 변경  )									*
 ***************************************************************************************************/
this.Tab_MATR_CI_onchanged = function(obj:Tab, e:nexacro.TabIndexChangeEventInfo)
{
	var strPlant = application.g_ds_Session.getColumn(0,"PLANT");
	
	if( this.Tab_MATR_CI.tabindex == 0 ){
		this.txt_PRD_LOT_NO.set_value("");
		this.txt_PRD_LOT_NO.set_visible(true);
		this.lab_PRD_LOT_NO.set_visible(true);
		if(strPlant == '1110') {
			this.btnAllPrint.set_visible(true);
		}
		
		this.static_authprd.set_left(802);
		this.cmb_AuthPrdCI.set_left(894);
	}else{
		this.txt_PRD_LOT_NO.set_value("");
		this.txt_PRD_LOT_NO.set_visible(false);
		this.lab_PRD_LOT_NO.set_visible(false);
		this.btnAllPrint.set_visible(false);
		
		this.static_authprd.set_left(588);
		this.cmb_AuthPrdCI.set_left(680);
	}
	
	//제품추적조회
    if(this.ViewPage=="QSEAR_30_PRD_TRACE"){
		if( this.Tab_MATR_CI.tabindex == 2 ){
			this.Div_FER1.grd_FER1.setFormatColProperty(this.Div_FER1.grd_FER1.getBindCellIndex("body", "HAL3_TEST_LOT"), "size", 0);
			this.Div_HAL1_2.grd_HAL1_2.setFormatColProperty(this.Div_HAL1_2.grd_HAL1_2.getBindCellIndex("body", "HAL3_TEST_LOT"), "size", 0);
			this.Div_HAL3.grd_HAL3.setFormatColProperty(this.Div_HAL3.grd_HAL3.getBindCellIndex("body", "ROH6_TEST_LOT"), "size", 0);
			
			if(strPlant == "1110"){
				this.Div_FER1.grd_FER1.setFormatColProperty(this.Div_FER1.grd_FER1.getBindCellIndex("body", "HAL3_TEST_LOT"), "size", 90);
				this.Div_HAL1_2.grd_HAL1_2.setFormatColProperty(this.Div_HAL1_2.grd_HAL1_2.getBindCellIndex("body", "HAL3_TEST_LOT"), "size", 90);
				this.Div_HAL3.grd_HAL3.setFormatColProperty(this.Div_HAL3.grd_HAL3.getBindCellIndex("body", "ROH6_TEST_LOT"), "size", 90);
				
				this.Div_HAL3.btnContMultiSearch.set_visible(true);
				this.Div_ROH6.btnMatrMultiSearch.set_visible(true);
				this.Div_HAL3.txtSearch_Count.set_right(259);
				this.Div_ROH6.txtSearch_Count.set_right(259);
			}
		}else{
			this.Div_FER1.grd_FER1.setFormatColProperty(this.Div_FER1.grd_FER1.getBindCellIndex("body", "HAL3_TEST_LOT"), "size", 0);
			this.Div_HAL1_2.grd_HAL1_2.setFormatColProperty(this.Div_HAL1_2.grd_HAL1_2.getBindCellIndex("body", "HAL3_TEST_LOT"), "size", 0);
			this.Div_HAL3.grd_HAL3.setFormatColProperty(this.Div_HAL3.grd_HAL3.getBindCellIndex("body", "ROH6_TEST_LOT"), "size", 0);
			this.Div_HAL3.btnContMultiSearch.set_visible(false);
			this.Div_ROH6.btnMatrMultiSearch.set_visible(false);
			
			if(strPlant == "1110"){
				this.Div_HAL3.txtSearch_Count.set_right(185);
				this.Div_ROH6.txtSearch_Count.set_right(185);
			}
		}
	}else{

		this.Div_FER1.grd_FER1.setFormatColProperty(this.Div_FER1.grd_FER1.getBindCellIndex("body", "HAL3_TEST_LOT"), "size", 0);
		this.Div_HAL1_2.grd_HAL1_2.setFormatColProperty(this.Div_HAL1_2.grd_HAL1_2.getBindCellIndex("body", "HAL3_TEST_LOT"), "size", 0);
		this.Div_HAL3.grd_HAL3.setFormatColProperty(this.Div_HAL3.grd_HAL3.getBindCellIndex("body", "ROH6_TEST_LOT"), "size", 0);
		this.Div_HAL3.btnContMultiSearch.set_visible(false);
		this.Div_ROH6.btnMatrMultiSearch.set_visible(false);
	}
	
	
	var TOBE = this.Tab_MATR_CI.tabindex;
	eval("this.ds_FER1.copyData(this.ds_TAB"+TOBE+"_FER1)");
	eval("this.ds_HAL3.copyData(this.ds_TAB"+TOBE+"_HAL3)");
	eval("this.ds_ROH6.copyData(this.ds_TAB"+TOBE+"_ROH6)");
	
	// 조회건수 : 0건
	this.Div_FER1.txtSearch_Count.set_text(this.gfn_GetMessage("1000",this.ds_FER1.getRowCount()));
	this.Div_HAL3.txtSearch_Count.set_text(this.gfn_GetMessage("1000",this.ds_HAL3.getRowCount()));
	this.Div_ROH6.txtSearch_Count.set_text(this.gfn_GetMessage("1000",this.ds_ROH6.getRowCount()));

	this.fn_Grd_Setting();
}

