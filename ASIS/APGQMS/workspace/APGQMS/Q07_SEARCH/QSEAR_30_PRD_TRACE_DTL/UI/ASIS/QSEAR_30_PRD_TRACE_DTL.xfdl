/***************************************************************************************************
 *											팝업 Callback											*
 ***************************************************************************************************/
this.fn_popupAfter = function(sPopupId, Variant)
{
	// 반환받은 문자열데이타 형변환(String, Array, Object) 처리
	var rtn = this.gfn_GetPopupRtn();
	
	switch(sPopupId){
		
		case "comExpandSearch": 
			if(rtn=="ok"){
				if(application.g_ds_Param.rowcount > 0){
					this.fn_ConditionReset();
					this.fn_Search("ok", this.Tab_MATR_CI.tabindex, "SEARCH" );
				}
			}
			break; 
		case "comExpandSearch2": 
			if(rtn=="ok"){
				if(application.g_ds_Param.rowcount > 0){
					this.fn_ConditionReset();
					this.fn_Search("ok2", this.Tab_MATR_CI.tabindex, "SEARCH" );
				}
			}
			break;
		case "comExpandSearch3": 
			if(rtn=="ok"){
				if(application.g_ds_Param.rowcount > 0){
					this.fn_ConditionReset();
					this.fn_Search("ok3", this.Tab_MATR_CI.tabindex, "SEARCH" );
				}
			}
			break;
	}
}

