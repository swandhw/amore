}
/***************************************************************************************************
 *				Div_HAL3_grd_HAL3_oncelldblclick(내용물 -> 완제품 / 내용물 -> 원료)				*
 ***************************************************************************************************/
this.Div_HAL3_grd_HAL3_oncelldblclick = function(obj:Grid, e:nexacro.GridClickEventInfo)
{
	// (완제품 TAB)
	if(this.Tab_MATR_CI.tabindex == 0){
		// 내용물 -> 원료
		this.txt_MNU_ORDER.set_value( this.ds_HAL3.getColumn(e.row, "ORDER_NO") );
		this.fn_Search("no", 2, "");
		
	// (내용물 TAB)
	}else if(this.Tab_MATR_CI.tabindex == 1){
		// 내용물 -> 원료
		this.txt_MNU_ORDER.set_value( this.ds_HAL3.getColumn(e.row, "ORDER_NO") );
		this.fn_Search("no", 2, "");
		
		// 내용물 -> 완제품	
		this.txt_HAL3_TEST_LOT.set_value( this.ds_HAL3.getColumn(e.row, "TEST_LOT") );
		this.txt_HAL3_BATCH_NO.set_value( "" );	
		
		//내용물 > 반제품, 성형물
		this.ds_Param.setColumn (0,"HAL1_2_TYPE","2");
		this.fn_Search("no", 0, "");	
	
	// (원료 TAB)
	}else if(this.Tab_MATR_CI.tabindex == 2){
		// 내용물 -> 완제품
			
		this.txt_HAL3_TEST_LOT.set_value( this.ds_HAL3.getColumn(e.row, "TEST_LOT") );
		//this.txt_HAL3_BATCH_NO.set_value( this.ds_HAL3.getColumn(e.row, "BATCH_NO") );
		this.txt_HAL3_BATCH_NO.set_value("");
				
		//내용물 > 반제품, 성형물
		this.ds_Param.setColumn (0,"HAL1_2_TYPE","2");
		this.fn_Search("no", 0, "");		
	}
}

