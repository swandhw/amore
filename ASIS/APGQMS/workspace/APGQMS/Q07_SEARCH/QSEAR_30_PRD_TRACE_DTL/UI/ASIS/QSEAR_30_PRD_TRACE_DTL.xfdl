this.Div_ROH6_btnMatrMultiSearch_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	// (원료 TAB)
	if(this.Tab_MATR_CI.tabindex == 2){
	
		var chkCnt = this.ds_ROH6.getCaseCount("CHK == '1'");
		
		if(chkCnt == 0){
			this.gfn_Message("1300", "OK"); // 선택된 데이터가 없습니다.
			return;
		}
		
		if(chkCnt > 10){
			this.gfn_Message("1964", "OK"); // 10개 이상 선택할수 없습니다
			return;
		}
		
		var findRow = -1;
		var testLots = "";
		for(var i = 0; i < 10; i++){
			if(i == 0){
				findRow = this.ds_ROH6.findRow("CHK", "1");
			}else{
				findRow = this.ds_ROH6.findRow("CHK", "1", (findRow+1));
			}
			
			if(findRow == -1){
				break;
			}
			
			testLots += this.ds_ROH6.getColumn(findRow, "TEST_LOT") + ",";
		}
		
		testLots = testLots.substr(0, testLots.length-1);
				
		this.txt_PAC_ORDER.set_value("");
		this.txt_PAC_ORDER_SEQ.set_value("");
		this.txt_PRD_TEST_LOT.set_value("");
		this.txt_ROH6_TEST_LOT.set_value(testLots);
		this.fn_Search("no", 1, "");
		
		this.ds_FER1.clearData();
	}
}

this.Div_HAL3_btnContMultiSearch_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
	// (원료 TAB)
	if(this.Tab_MATR_CI.tabindex == 2){
	
		var chkCnt = this.ds_HAL3.getCaseCount("CHK == '1'");
		
		if(chkCnt == 0){
			this.gfn_Message("1300", "OK"); // 선택된 데이터가 없습니다.
			return;
		}
		
		if(chkCnt > 10){
			this.gfn_Message("1964", "OK"); // 10개 이상 선택할수 없습니다
			return;
		}
		
		var findRow = -1;
		var testLots = "";
		
		for(var i = 0; i < 10; i++){
			if(i == 0){
				findRow = this.ds_HAL3.findRow("CHK", "1");
			}else{
				findRow = this.ds_HAL3.findRow("CHK", "1", (findRow+1));
			}
			
			if(findRow == -1){
				break;
			}
			
			testLots += this.ds_HAL3.getColumn(findRow, "TEST_LOT") + ",";
		}
		
		testLots = testLots.substr(0, testLots.length-1);
		
		this.txt_HAL3_TEST_LOT.set_value( testLots );
		this.txt_HAL3_BATCH_NO.set_value( "" );	
		
		this.ds_Param.setColumn (0,"HAL1_2_TYPE","2");
		this.fn_Search("no", 0, "");
	}
}]]></Script>
