	this.fn_Grd_Setting ();
	
	this.vscrollbar.set_pos(0);
}
this.fn_Find = function(sTransition, sArgument)
{
	this.gfn_DsSetTransaction(this, sTransition, this.ds_Service, sArgument);
}
/***************************************************************************************************
 *								fn_ConditionReset( 2차 조건 reset )								*
 ***************************************************************************************************/
this.fn_ConditionReset = function(){

	this.txt_HAL3_TEST_LOT.set_value("");
	this.txt_HAL3_BATCH_NO.set_value("");
	
	this.txt_PAC_ORDER.set_value("");
	this.txt_PAC_ORDER_SEQ.set_value("");
	this.txt_PRD_TEST_LOT.set_value("");
	this.txt_ROH6_TEST_LOT.set_value("");
	
	this.txt_MNU_ORDER.set_value("");
}
/***************************************************************************************************
 *										btnSearch_onclick( 조회 )									*
 ***************************************************************************************************/
this.btnSearch_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{	
	this.fn_ConditionReset();
	this.fn_Search("no", this.Tab_MATR_CI.tabindex, "SEARCH");
}
this.fn_Search = function(sExpandSearch, sSEQ, sSEARCH_CI ) {
	var addQueryString="";
	var addQueryString2="";
	
	//확장검색
	if( sExpandSearch == "ok" ){		
		if(application.g_ds_Param.rowcount > 0){
			var addString = this.gfn_dsParamQuarryStr(application.g_ds_Param);			
			addQueryString = " AND TR.MATR_CODE IN (" + addString + ")";	
		}
	} 
	if( sExpandSearch == "ok2" ){		
		if(application.g_ds_Param.rowcount > 0){
			var addString = this.gfn_dsParamQuarryStr(application.g_ds_Param);
			addQueryString = " AND TR.BATCH_NO IN(" + addString + ")";	
		}
	}
	if( sExpandSearch == "ok3" ){		
		if(application.g_ds_Param.rowcount > 0){
			var addString = this.gfn_dsParamQuarryStr(application.g_ds_Param);
			addQueryString2 = " AND C.LOT_NO IN (" + addString + ")";
		}
	}
	var sMICRO_DETECT = "N";
	if(this.ViewPage=="QTSMR_91_MICRO_TRACE")
	{	
		// 미생물 검사 검출여부
		if(this.chk_MICRO_DETECT.value){
			sMICRO_DETECT = "Y";
		}
	}	
	if( sSEARCH_CI == "SEARCH") {
		if( this.chk_DATE.value == false && this.gfn_IsEmpty(addQueryString) && this.gfn_IsEmpty(this.txt_MATR_CODE.value) && this.gfn_IsEmpty(this.txt_MATR_NAME.value) && this.gfn_IsEmpty(this.txt_BATCH_NO.value) && this.gfn_IsEmpty(this.txt_ORDER_NO.value) && this.gfn_IsEmpty(this.txt_PRD_LOT_NO.value)){
			//5671	조회조건을 한가지 이상 입력하여 주십시오.
			this.gfn_Message("5671","OK"); 
			return;
		}
	}	
	var START_DATE = this.calLOT_CREATE_DATE1.value;
	var END_DATE = this.gfn_IsEmpty(this.calLOT_CREATE_DATE2.value)?this.gfn_Today():this.calLOT_CREATE_DATE2.value;	
	
	if(this.gfn_IsEmpty(START_DATE) || this.gfn_IsEmpty(END_DATE)) {
		this.gfn_Message("5257","OK");
		return;
	}	
	//날짜조건 필수!!  여기부터 다시 보기 -- 자재코드, 배치번호, 오더번호 중 하나라도 선택
	if(this.gfn_IsEmpty(this.txt_MATR_CODE.value) && this.gfn_IsEmpty(this.txt_BATCH_NO.value) && this.gfn_IsEmpty(this.txt_ORDER_NO.value)) {
		
		var addStartDate = !this.gfn_IsEmpty(START_DATE)?this.gfn_AddMonth (START_DATE.toString(), 6):'10000101';
		
		if(this.gfn_IsEmpty(START_DATE) || this.gfn_IsEmpty(END_DATE)) {
			this.gfn_Message("6129","OK"); 		//날짜 조건은 필수 조회조건 입니다.(5257) -> (자재코드, 제조번호 또는 오더번호를 조회조건으로 미입력 시 \n\n날짜 조건은 필수 조회조건 입니다.)
			return;
		} else if (addStartDate < END_DATE.toString()) {
			this.gfn_Message("6128","OK");   	//로트 생성일을 6개월 이내로 설정해 주세요.
			return;
		}
	}
	
	if( sSEQ == 0 ) {
		// 완제품		
		// data clear
		this.ds_FER1.clearData();
		
		// grd  헤더에 체크 되어있던거 풀어준다..
		var Col = this.Div_FER1.grd_FER1.getBindCellIndex("body", "CHK")
		var bSucc = this.Div_FER1.grd_FER1.setCellProperty( "Head", Col, "text", "0");			
		this.ds_Param.setColumn (0,"ADDQUEERYSTRING", 	addQueryString);
		this.ds_Param.setColumn (0,"ADDQUEERYSTRING2", 	addQueryString2);
		this.ds_Param.setColumn (0,"MICRO_DETECT", 		sMICRO_DETECT);
		var sArgument = this.gfn_GetFilterParam(this.Div_FER1.grd_FER1);	
		if(application.g_ds_Session.getColumn(0,"PLANT")=="1110") {
			this.fn_Find ("find_HAL1_2", "");	
		}
		this.fn_Find ("find_FER1", sArgument);
		
	}else if( sSEQ == 1) {
		// 내용물		
		// data clear
		this.ds_HAL3.clearData();
		
		// grd  헤더에 체크 되어있던거 풀어준다..
		var Col = this.Div_HAL3.grd_HAL3.getBindCellIndex("body", "CHK")
		var bSucc = this.Div_HAL3.grd_HAL3.setCellProperty( "Head", Col, "text", "0");
				
		this.ds_Param.setColumn (0,"ADDQUEERYSTRING", 	addQueryString);
		this.ds_Param.setColumn (0,"ADDQUEERYSTRING2", 	addQueryString2);
		this.ds_Param.setColumn (0,"MICRO_DETECT", 		sMICRO_DETECT);
		var sArgument = this.gfn_GetFilterParam(this.Div_HAL3.grd_HAL3);
		if(application.g_ds_Session.getColumn(0,"PLANT")=="1110") {
			this.fn_Find ("find_HAL1_2", "");
		}
		this.fn_Find ("find_HAL3", sArgument);
				
	}else if( sSEQ == 2){
		// 원료		
		// data clear
		this.ds_ROH6.clearData();
		
		// grd  헤더에 체크 되어있던거 풀어준다..
		var Col = this.Div_ROH6.grd_ROH6.getBindCellIndex("body", "CHK")
		var bSucc = this.Div_ROH6.grd_ROH6.setCellProperty( "Head", Col, "text", "0");
		this.ds_Param.setColumn (0,"ADDQUEERYSTRING", 	addQueryString);
		this.ds_Param.setColumn (0,"ADDQUEERYSTRING2", 	addQueryString2);
		this.ds_Param.setColumn (0,"MICRO_DETECT", 		sMICRO_DETECT);		
		if(this.Tab_MATR_CI.tabindex == 0){
			this.ds_Param.setColumn (0,"PAC_ORDER", 		this.pack_order);
			this.ds_Param.setColumn (0,"PAC_ORDER_SEQ", 	this.pack_order_seq);
		}
		var sArgument = this.gfn_GetFilterParam(this.Div_ROH6.grd_ROH6);		
		this.fn_Find ("find_ROH6", sArgument);		
	}
}
/***************************************************************************************************
 *											트렌젝션  CallBack										*
 ***************************************************************************************************/
this.fn_CallBack = function (sSvcID, nErrorCode, sErrorMsg) {
	//transaction Error 처리
	if(!this.gfn_CheckTranResult(this, sSvcID, nErrorCode, sErrorMsg)) return;	
	
	switch(this.gfn_GetSvcId(sSvcID)) {//get service id 
		
		case "find_FER1":
			// 조회건수 : 0건
			this.Div_FER1.txtSearch_Count.set_text(this.gfn_GetMessage("1000",this.ds_FER1.getRowCount()));
			this.fn_ConditionReset();
			this.fn_Grd_Setting();
			break;
		case "find_HAL1_2":
			// 조회건수 : 0건
			this.Div_HAL1_2.txtSearch_Count.set_text(this.gfn_GetMessage("1000",this.ds_HAL1_2.getRowCount()));
			this.fn_ConditionReset();
			this.fn_Grd_Setting();
			break;	
		case "find_HAL3":
			// 조회건수 : 0건
			this.Div_HAL3.txtSearch_Count.set_text(this.gfn_GetMessage("1000",this.ds_HAL3.getRowCount()));
			this.fn_ConditionReset();
			this.fn_Grd_Setting();
			break;
		case "find_ROH6":
			// 조회건수 : 0건
			this.Div_ROH6.txtSearch_Count.set_text(this.gfn_GetMessage("1000",this.ds_ROH6.getRowCount()));
			this.fn_ConditionReset();
			this.fn_Grd_Setting();
			break;
		case "AUTHPRD":
		//제2뷰티 권한은 1뷰티 정보를 못 보게 한다.
			if(this.gLevel == "T") {
				this.cmb_AuthPrdCI.set_value(this.ds_AuthPrdCI.getColumn(this.ds_AuthPrdCI.findRow("CODE",this.gLevel),"USER_DEFINE0"));
				this.cmb_AuthPrdCI.set_enable(false);
			}else{
				this.cmb_AuthPrdCI.set_index(0);
			}
			break;
		case "find_AUTHORITY_PAGE":
			if( this.gfn_IsEmpty( this.ds_QMS51.getColumn(0, "CODE_NAME"))){
				var AUTHORITY = "Y";
			}else{
				var AUTHORITY = this.gfn_Trim( this.ds_QMS51.getColumn(0, "CODE_NAME"));
			}
			
			// 숨김모드일때..
			if( AUTHORITY == "N") {	
				var sPAGE_NAME = "QSEAR_30_PRD_TRACE";
				this.ds_QMS52.filter("CODE_NAME=='"+sPAGE_NAME+"'");
				
				var grd_name ="";
				var fild_name = "";
				for(var i=0; i<this.ds_QMS52.rowcount; i++){
					grd_name = this.ds_QMS52.getColumn(i, "USER_DEFINE0");
					fild_name = this.ds_QMS52.getColumn(i, "USER_DEFINE1");					
					eval(grd_name).setFormatColProperty(eval(grd_name).getBindCellIndex("body", fild_name), "size", 0);				
				}
			}
			break;
		case "save_PRT_INSERT":
			if(sErrorMsg == 'SUCC') {
				this.fn_PRT ();
			}
			break;
	}
}
this.fn_Grd_Setting = function() {
	var strPlant = application.g_ds_Session.getColumn(0,"PLANT");	
	if(this.Tab_MATR_CI.tabindex == 0) {
		this.Div_FER1.set_top(86);
		this.Div_FER1.set_height(225);
		
		if(this.ds_HAL1_2.getRowCount() > 9 ) {
			var nheight = (9*24)+125;
		}else{
			var nheight = (this.ds_HAL1_2.getRowCount()*24)+125;
		}
		this.Div_HAL1_2.set_top( parseInt(this.Div_FER1.top) + parseInt(this.Div_FER1.height));
		if (strPlant != '1110') {
			nheight = 0;
		}
		this.Div_HAL1_2.set_height(nheight);
		
		if(this.ds_HAL3.getRowCount() > 9 ) {
			var nheight = (9*24)+125;
		}else{
			var nheight = (this.ds_HAL3.getRowCount()*24)+125;
		}
		this.Div_HAL3.set_top( parseInt(this.Div_HAL1_2.top) + parseInt(this.Div_HAL1_2.height));
		this.Div_HAL3.set_height(nheight);
		
		var nheight = (this.ds_ROH6.getRowCount()*24)+125;
		this.Div_ROH6.set_top( parseInt(this.Div_HAL3.top) + parseInt(this.Div_HAL3.height));
		this.Div_ROH6.set_height(nheight);

		this.lab_TEST_RESULT.set_top( parseInt(this.Div_ROH6.top) +  parseInt(this.Div_ROH6.height) + 10);
		
		//2019/06/28 JNK SYSTEM KHG 엑셀시트명
		this.excelsheet1 = this.Div_FER1.caption01.text; //완제품
		this.excelsheet2 = this.Div_HAL1_2.caption01.text; //반제품, 성형물
		this.excelsheet3 = this.Div_HAL3.caption01.text; // 내용물
		this.excelsheet4 = this.Div_ROH6.caption01.text; //원료
		
	}else if(this.Tab_MATR_CI.tabindex == 1){
	
		this.Div_HAL3.set_top(86);
		this.Div_HAL3.set_height(225);
		
		if(this.ds_FER1.getRowCount() > 9 ){
			var nheight = (9*24)+125;
		}else{
			var nheight = (this.ds_FER1.getRowCount()*24)+125;
		}
		this.Div_FER1.set_top( 86+ parseInt(this.Div_HAL3.height));
		this.Div_FER1.set_height(nheight);
		
		if(this.ds_HAL1_2.getRowCount() > 9 ) {
			var nheight = (9*24)+125;
		}else{
			var nheight = (this.ds_HAL1_2.getRowCount()*24)+125;
		}
		this.Div_HAL1_2.set_top( parseInt(this.Div_FER1.top) + parseInt(this.Div_FER1.height) );
		if (strPlant != '1110') {
			nheight = 0;
		}
		this.Div_HAL1_2.set_height(nheight);
		
		var nheight = (this.ds_ROH6.getRowCount()*24)+125;
		this.Div_ROH6.set_top( parseInt(this.Div_HAL1_2.top) + parseInt(this.Div_HAL1_2.height) );
		this.Div_ROH6.set_height(nheight);

		this.lab_TEST_RESULT.set_top( parseInt(this.Div_ROH6.top) +  parseInt(this.Div_ROH6.height) + 10);
		
		//2019/06/28 JNK SYSTEM KHG 엑셀시트명
		this.excelsheet1 = this.Div_HAL3.caption01.text; // 내용물
		this.excelsheet2 = this.Div_FER1.caption01.text; //완제품
		this.excelsheet3 = this.Div_HAL1_2.caption01.text; //반제품, 성형물
		this.excelsheet4 = this.Div_ROH6.caption01.text; //원료
		
	}else if(this.Tab_MATR_CI.tabindex == 2){
	
		this.Div_ROH6.set_top(86);
		this.Div_ROH6.set_height(225);
		
		if(this.ds_HAL3.getRowCount() >9 ){
			var nheight = (9*24)+125;
		}else{
			var nheight = (this.ds_HAL3.getRowCount()*24)+125;
		}
		this.Div_HAL3.set_top( parseInt(this.Div_ROH6.top) + parseInt(this.Div_ROH6.height));
		this.Div_HAL3.set_height(nheight);
		
		var nheight = (this.ds_FER1.getRowCount()*24)+125;
		this.Div_FER1.set_top( parseInt(this.Div_HAL3.top) + parseInt(this.Div_HAL3.height));
		this.Div_FER1.set_height(nheight);
		
		if(this.ds_HAL1_2.getRowCount() > 9 ) {
			var nheight = (9*24)+125;
		}else{
			var nheight = (this.ds_HAL1_2.getRowCount()*24)+125;
		}
		this.Div_HAL1_2.set_top( parseInt(this.Div_FER1.top) + parseInt(this.Div_FER1.height));
		if (strPlant != '1110') {
			nheight = 0;
		}
		this.Div_HAL1_2.set_height(nheight);
		
		this.lab_TEST_RESULT.set_top( parseInt(this.Div_HAL1_2.top) +  parseInt(this.Div_HAL1_2.height) +10);
		
		//2019/06/28 JNK SYSTEM KHG 엑셀시트명
		this.excelsheet1 = this.Div_ROH6.caption01.text; //원료
		this.excelsheet2 = this.Div_HAL3.caption01.text; // 내용물
		this.excelsheet3 = this.Div_FER1.caption01.text; //완제품
		this.excelsheet4 = this.Div_HAL1_2.caption01.text; //반제품, 성형물
		
	}	
	this.resetScroll();
}
/***************************************************************************************************
 *					Div_FER1_grd_FER1_oncelldblclick(완제품 -> 내용물)							*
 ***************************************************************************************************/
this.Div_FER1_grd_FER1_oncelldblclick = function(obj:Grid, e:nexacro.GridClickEventInfo)
{
