		this.txt_PAC_ORDER.set_value( 		this.ds_FER1.getColumn(e.row, "ORDER_NO") );
		this.txt_PAC_ORDER_SEQ.set_value( 	this.ds_FER1.getColumn(e.row, "ORDER_SEQ") );
		this.txt_PRD_TEST_LOT.set_value( 	this.ds_FER1.getColumn(e.row, "TEST_LOT") );
		this.txt_WRK_ORDER_DATE.set_value( 	this.ds_FER1.getColumn(e.row, "WRK_ORDER_DATE") );
		this.ds_Param.setColumn (0,"HAL1_2_TYPE","1");
		this.txt_ROH6_TEST_LOT.set_value("");
		this.fn_Search("no", 1, "");	// 내용물 조회		
