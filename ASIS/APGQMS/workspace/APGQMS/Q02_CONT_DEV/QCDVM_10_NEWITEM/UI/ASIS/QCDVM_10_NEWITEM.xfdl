    <Script type="xscript5.0"><![CDATA[/*************************   Program description   ****************************
 File Name      : QCDVM_10_NEWITEM
 File Desc.     : 
 Author         : SMKWON
 Create Date    : 2015/05/28
 Change History :
*******************************************************************************/

/*****************************
 *  공통 Script Include      *
 ****************************/
include "js::QMS_COMMON.xjs"

/*****************************
 *  화면 변수 선언부       *
 ****************************/

/***************************************************************************************************
 *                                   화면 onload Event 처리 부분                                    *
 ***************************************************************************************************/
this.QCDVM_10_NEWITEM_onload = function(obj:Form, e:nexacro.LoadEventInfo)
{
	this.gfn_FormLoadSetting(obj);	
	this.gfn_GridSetting(obj);
	this.gfn_DivBorderSetting(obj);
	
	// 화면 권한 체크 (버튼 활성,비활성 설정 // 1. 조회, 등록, 저장, 종료)
	this.gfn_QmsCommL3AuthChk(true , "1");
	
	if (application.g_ds_Session.getColumn(0,"PLANT") != "CN20"){
		this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setFormatColProperty(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.getBindCellIndex("body", "SAP_USE_LIMIT"), "size", 0); 
	}
		
	// 뷰티만 안정성 의뢰 보이게 변경
	if (application.g_ds_Session.getColumn(0,"PLANT") == "1110"){
		if (application.g_ds_Session.getColumn(0,"USER_PRD_CI") != "MU"){
			this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setFormatColProperty(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.getBindCellIndex("body", "SPEC_YN"), "size", 0); 
			this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setFormatColProperty(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.getBindCellIndex("body", "STAB_YN"), "size", 0); 
		}
	
		// ds_STAB_REQ_CI :: PILOT 안정성 의뢰
		var sSvcNm = "QMS_COMM_CODE_LANG-service"; 
		var sTransition = "find";
		var sInDataSet  = "";
		var sOutDataSet = "ds_STAB_REQ_CI=dsr_SearchListResult";
		var sArgument =  this.gfn_ParamSetting("CODE_TABLE_ID", "NEW29")
						+this.gfn_ParamSetting("HIGH_CODE", "") 
						+this.gfn_ParamSetting("LANG_TYPE", application.g_ds_Session.getColumn(0,"LANG_TYPE"))
						+this.gfn_ParamSetting("ADDQUEERYSTRING", "")
						;					
		this.gfn_Transaction(this, "find_STAB_REQ_CI", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack");
	}else{	
		this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setFormatColProperty(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.getBindCellIndex("body", "STAB_REQ_CI"), "size", 0);
	
	}
	
	// 데일리 뷰티만 제품특징, 기타정보, 파일럿-MES진행사항 보이게 변경
	if (application.g_ds_Session.getColumn(0,"PLANT") != "1111")
	{
		this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setFormatColProperty(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.getBindCellIndex("body", "PRD_CHAR"), "size", 0); 
		this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setFormatColProperty(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.getBindCellIndex("body", "ETC_INFO"), "size", 0); 
		this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setFormatColProperty(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.getBindCellIndex("body", "ETC"), "size", 0); 
	}
	
	if (application.g_ds_Session.getColumn(0,"PLANT") == "1111")
	{
		// 데일리뷰티만 1주차 안정도 판정 보이게 변경
		this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setFormatColProperty(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.getBindCellIndex("body", "WK1_QMS_PLOT_STAB_JUDG_CD"), "size", 100); 

 		// 데일리뷰티만 안정도 판정 -> 2주차 안정도 판정으로 보이게 변경
 		this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST.setCellProperty("Head",28,"text", "2주차 안정도판정");
	}
	
	//Create Date
	var sDate  = new Date();
	//Create Date String(YYYYMMDD)
	var strday  =  sDate.getFullYear() + "";
		strday += this.gfn_Right("0" + ( sDate.getMonth() - 0), 2);
		strday += this.gfn_Right("0" +  sDate.getDate(), 2); 
		
	this.DivS.calDATE1.set_value( sDate.getFullYear() + "0101");	
	this.DivS.calDATE2.set_value(this.gfn_Today());
	
	
	// 뷰티(1110/1111) 변경이력 Tab에 focus 한번 준다.
	if(application.g_ds_Session.getColumn(0,"PLANT") == "1110" || application.g_ds_Session.getColumn(0,"PLANT") == "1111"){
		this.DivR.Tab00.set_tabindex(4); 
		
	// 뷰티(1110/1111)이 아니면 변경이력 Tab 삭제한다.
	}else{
		this.DivR.Tab00.removeTabpage(4);
	}
	this.DivR.Tab00.set_tabindex(2); 
	this.DivR.Tab00.set_tabindex(1); 
	
//	this.gfn_LeftFrameShowHide("show");
	this.gfn_LeftFrameShowHide("hide");
	
	//this.QCDVM_10_NEWITEM_onsetfocus();
}

/***************************************************************************************************
 *                                 btnSearch_onclick( 조회 )                                      *
 ***************************************************************************************************/
this.btnSearch_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
	this.fn_Search("no");
}

this.fn_Search = function(sExpandSearch) {
	var addQueryString="";
	
	//확장검색 (자재코드)
	if( sExpandSearch == "ok" ){
		if(application.g_ds_Param.rowcount > 0){
			var addString = this.gfn_dsParamQuarryStr(application.g_ds_Param);
			addQueryString = " AND NI.MATR_CODE IN(" + addString + ")";	
		}
	}
	// 조회조건 활성화
	if( this.DivS.visible == false ){
		this.DivS.set_visible(true);
		this.DivR.set_top(this.belowPosition);
	}

	//첫번째 탭 활성화
	if(this.DivR.Tab00.tabindex != "0") {	
		this.DivR.Tab00.set_tabindex(0);
		return;
	}
	
	if( this.DivS.chk_DATE.value == true){
		var START_DATE = this.DivS.calDATE1.value;
		var END_DATE = this.DivS.calDATE2.value;
		var DATE_CI = this.DivS.cmbDATE_CI.value;
	}else{
		var START_DATE = "00000000";
		var END_DATE = "99999999";
		var DATE_CI = "NVL(NI.RPT_DATE,^00000000^)";	// 날짜 조건이 빠지면 무조건 발행일자 기준으로 조회하게 한다. pilot 일자는 null이 많음. 발행일자도 NULL이 많네 .. ㅠㅠ
		
		if( this.gfn_IsEmpty(addQueryString) && this.gfn_IsEmpty(this.DivS.txtMATR_CODE.value) && this.gfn_IsEmpty(this.DivS.txtMATR_NAME.value) ){
			//5672	조회조건이 없으면 속도가 오래걸릴수 있습니다. 계속하시겠습니까?
			var saveMsg = this.gfn_Message("5672", "YESNO");  
			if (saveMsg == false) {
				return;
			}
		}
	}
	
	
	
	this.ds_NEWITEM_LIST.clearData();
	
	if( this.DivS.rdoSearch_CI.value == "1"){
		// Pilot 전체보기
		var sTransition = "find_New_Item_1";
	}else{
		// Pilot 최종보기
		var sTransition = "find_New_Item_2";
	}
	var sSvcNm = "QCDVM_10_NEWITEM-service"; 	
	var sInDataSet  = "";
	var sOutDataSet = "ds_NEWITEM_LIST=dsr_SearchResultNewItem";
	var sArgument = this.gfn_ParamSetting("PLANT", 			application.g_ds_Session.getColumn(0,"PLANT")) 
					+this.gfn_ParamSetting("PRD_CI", 		application.g_ds_Session.getColumn(0,"USER_PRD_CI"))
					+this.gfn_ParamSetting("CUD_CI", 		this.DivS.cmbCUD_CI.value) 
					+this.gfn_ParamSetting("MATR_CODE", 	this.DivS.txtMATR_CODE.value)
					+this.gfn_ParamSetting("MATR_NAME", 	this.DivS.txtMATR_NAME.value)
					+this.gfn_ParamSetting("START_DATE",	START_DATE)
					+this.gfn_ParamSetting("END_DATE", 		END_DATE) 
					+this.gfn_ParamSetting("ADDQUEERYSTRING", 	addQueryString)
					+this.gfn_ParamSetting("ADDQUEERYSTRING2", 	DATE_CI)	/* 발행일자:NI.RPT_DATE/ PILOT일자:NP.PILOT_DATE (전체보기에서만 사용함)*/
					;
	//필터적용				
	sArgument += this.gfn_GetFilterParam(this.DivR.Tab00.tabpage1.grd_NEWITEM_LIST);
	
	this.gfn_Transaction(this, "find_New_Item", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack");
	
	
	
}


/***************************************************************************************************
 *                                 grd_NEWITEM_LIST_oncelldblclick( 선택 )                                      *
 ***************************************************************************************************/
this.grd_NEWITEM_LIST_oncelldblclick = function(obj:Grid, e:nexacro.GridClickEventInfo)
{	
	this.fn_matr_search(this.ds_NEWITEM_LIST.getColumn(e.row, "MATR_CODE"));
}
this.fn_matr_search = function (strCode) {
	// 조회조건 비활성화
	if( this.DivS.visible == true ){
		this.belowPosition = this.DivR.top;//이전 top position 저장
		
		this.DivS.set_visible(false);
		this.DivR.set_top(51);
	}
	
	//두번째 탭 활성화
	if(this.DivR.Tab00.tabindex != "1") {	
		this.DivR.Tab00.set_tabindex(1); 
	}
	this.DivR.Tab00.tabpage2.btnReset_onclick("ALL");
	this.DivR.Tab00.tabpage2.txt_MATR_CODE.set_value(strCode);
	this.DivR.Tab00.tabpage2.fn_MATR_SEARCH();
}
/***************************************************************************************************
 *										btnSave_onclick( 저장 )										*
 ***************************************************************************************************/
this.btnSave_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{	
	if(this.DivR.Tab00.tabindex != "1") {	
		this.DivR.Tab00.set_tabindex(1); 
	}
	
	this.DivR.Tab00.tabpage2.btnSave_onclick();
}

/***************************************************************************************************
 *										btnReset_onclick( 리셋 )									*
 ***************************************************************************************************/
this.btnReset_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{	
	// 조회조건 비활성화
	if( this.DivS.visible == true ){
		this.belowPosition = this.DivR.top;//이전 top position 저장
		
		this.DivS.set_visible(false);
		this.DivR.set_top(51);
	}
	
	//두번째 탭 활성화
	if(this.DivR.Tab00.tabindex != "1") {	
		this.DivR.Tab00.set_tabindex(1); 
	}
	
	this.DivR.Tab00.tabpage2.btnReset_onclick("ALL");
}


/***************************************************************************************************
 *                                fn_CallBack                               *
 ***************************************************************************************************/
// Transaction 후 처리 해야 할 내용!

this.fn_CallBack = function (sSvcID, nErrorCode, sErrorMsg) {

	//transaction Error 처리
	if(!this.gfn_CheckTranResult(this, sSvcID, nErrorCode, sErrorMsg)) return;
	
	switch(this.gfn_GetSvcId(sSvcID)) {//get service id 

		case "find_New_Item":
			// 조회건수 : 0건
			this.DivR.Tab00.tabpage1.txtSearch_Count.set_text(this.gfn_GetMessage("1000",this.ds_NEWITEM_LIST.getRowCount()));
			break;
		case "find_STAB_REQ_CI":
			break;
		default:
			break;
	}
}


this.DivR_Tab00_onchanged = function(obj:Tab, e:nexacro.TabIndexChangeEventInfo)
{
	if(this.DivR.Tab00.tabindex == "0") {
		// 조회
		// 조회조건 활성화
		if( this.DivS.visible == false ){
			this.DivS.set_visible(true);
			this.DivR.set_top(this.belowPosition);
		}
	}else{
		// 상세내역
		// 조회조건 비활성화
		if( this.DivS.visible == true ){
			this.belowPosition = this.DivR.top;//이전 top position 저장
			
			this.DivS.set_visible(false);
			this.DivR.set_top(51);
		}
	}
	
	//안정성검사 탭 선택 시
	//상세내역이 정보가 없으면 안정성 검사정보도 없다. 즉 상세내역을 먼저 조회해야 한다.
	if(this.DivR.Tab00.tabindex == "2") {
	
		if( this.gfn_IsEmpty(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value) ){
			this.DivR.Tab00.tabpage3.txt_MATR_CODE.set_value("");
			this.DivR.Tab00.tabpage3.fn_RESET();
		}else if( this.gfn_Trim(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value) != this.gfn_Trim(this.DivR.Tab00.tabpage3.txt_MATR_CODE.value)){
			this.DivR.Tab00.tabpage3.txt_MATR_CODE.set_value(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value);
			this.DivR.Tab00.tabpage3.fn_MAIN_STAB_SETTING();
		}
	}
	
	
	// BOM
	if(this.DivR.Tab00.tabindex == "3") {
		if( this.gfn_IsEmpty(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value) ){
			this.DivR.Tab00.tabpage4.bom_Div.txt_MATR_CODE.set_value("");
			this.DivR.Tab00.tabpage4.bom_Div.txt_MATR_NAME.set_value("");
			this.DivR.Tab00.tabpage4.bom_Div.ds_MAIN_BOM.clearData(); 
		}else if( this.gfn_Trim(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value) != this.gfn_Trim(this.DivR.Tab00.tabpage4.bom_Div.txt_MATR_CODE.value)){
			this.DivR.Tab00.tabpage4.bom_Div.txt_MATR_CODE.set_value(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value);
			this.DivR.Tab00.tabpage4.bom_Div.txt_MATR_NAME.set_value(this.DivR.Tab00.tabpage2.txt_MATR_NAME.value); 
			this.DivR.Tab00.tabpage4.bom_Div.btn_BOM_Refresh_onclick(); 			
		}
	}
	
	
	// 이력조회
	if(this.DivR.Tab00.tabindex == "4") {
		if( this.gfn_IsEmpty(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value) ){
			this.DivR.Tab00.tabpage5.txt_MATR_CODE.set_value("");
			this.DivR.Tab00.tabpage5.txt_MATR_NAME.set_value("");
			this.DivR.Tab00.tabpage5.calDATE2.set_value(this.gfn_Today());
			this.DivR.Tab00.tabpage5.calDATE1.set_value(this.gfn_AddDate(this.gfn_Today(), -365));
			this.DivR.Tab00.tabpage5.ds_CHNG_INFO.clearData(); 			
			
		}else if( this.gfn_Trim(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value) != this.gfn_Trim(this.DivR.Tab00.tabpage5.txt_MATR_CODE.value)){
			this.DivR.Tab00.tabpage5.txt_MATR_CODE.set_value(this.DivR.Tab00.tabpage2.txt_MATR_CODE.value);
			this.DivR.Tab00.tabpage5.txt_MATR_NAME.set_value(this.DivR.Tab00.tabpage2.txt_MATR_NAME.value); 
			this.DivR.Tab00.tabpage5.txt_PLANT.set_value(application.g_ds_Session.getColumn(0,"PLANT"));
			this.DivR.Tab00.tabpage5.calDATE2.set_value(this.gfn_Today());
			this.DivR.Tab00.tabpage5.calDATE1.set_value(this.gfn_AddDate(this.gfn_Today(), -365));
			this.DivR.Tab00.tabpage5.btn_Refresh_onclick(); 
			
		}else{
			if( this.DivR.Tab00.tabpage2.vsChngHistoryFlag == true){
				this.DivR.Tab00.tabpage2.vsChngHistoryFlag = false;
				this.DivR.Tab00.tabpage5.btn_Refresh_onclick();
			}
		}
	}
	

}


/***************************************************************************************************
 *                                 btnExpandSearch_onclick( 자재코드 확장검색 )                            *
 ***************************************************************************************************/
this.btnExpandSearch_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
    this.gfn_OpenPopup("comExpandSearch","COMMON::comExpandSearch.xfdl",{title: this.DivS.labMATR_CODE.text },"fn_popupAfter");	
}

// 팝업 Callback
this.fn_popupAfter = function(sPopupId, Variant)
{
	// 반환받은 문자열데이타 형변환(String, Array, Object) 처리
	var rtn = this.gfn_GetPopupRtn();
	
	switch(sPopupId){
		// 확장검색
		case "comExpandSearch": 
			if(rtn=="ok"){
				if(application.g_ds_Param.rowcount > 0){
					this.fn_Search("ok");
				}
			}
			break;	
		default:
			break;
	}
}


/***************************************************************************************************
*					                            출력	                                           	*
***************************************************************************************************/

this.btnPRINT_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{	
	if(this.gfn_IsEmpty(this.txt_MATR_CODE.value))
	{
		this.gfn_Message("5762","OK"); //5762	항목을 선택하여 주십시오.
		return;
	}
    var sFileName = "QCDVM_10_NEWITEM_DTL_PRINT";
	var sResultFileName="";
	var sDirectPrint="";   
	
	var sParam1 = application.g_ds_Session.getColumn(0,"PLANT");
	var sParam2 = this.txt_MATR_CODE.value;
	
	var sParam = "FILENAME="+sFileName+"&RESULTFILENAME="+sResultFileName+"&PARAM1="+sParam1+"&PARAM2="+sParam2+"&DIRECTPRINT="+this.gfn_DeleteUndefine(sDirectPrint)+"&LANG_TYPE="+application.g_ds_Session.getColumn(0,"LANG_TYPE");
	this.webRd01.set_url(application.services["URL"].url + "callReport.jsp?"+encodeURI(sParam));
}
