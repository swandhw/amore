}
/***************************************************************************************************
 *							txt_Search_onkeyup(조회조건 입력후 Enter)							*
 **************************************************************************************************/
this.txt_Search_onkeyup = function(obj:Edit, e:nexacro.KeyEventInfo)
{
	// Enter Key
	if(e.keycode == 13){
		this.btnSearch_onclick();
	}
}
this.DivS_chk_DATE_onchanged = function(obj:CheckBox, e:nexacro.CheckBoxChangeEventInfo)
{
	if( this.DivS.chk_DATE.value == true){
		this.DivS.calDATE1.set_readonly(false);
		this.DivS.calDATE2.set_readonly(false);
	}else{
		this.DivS.calDATE1.set_readonly(true);
		this.DivS.calDATE2.set_readonly(true);
	}
}
/***************************************************************************************************
 *										focus												*
 **************************************************************************************************/
this.QCDVM_10_NEWITEM_onsetfocus = function(obj:Form, e:nexacro.SetFocusEventInfo)
{
	if( !this.gfn_IsEmpty(application.g_Page_Param) ) {
		var strCode = application.g_Page_Param;
		//alert(strCode);
		this.fn_matr_search(strCode);
		application.g_Page_Param = "";
	}
}
]]></Script>
  </Form>
