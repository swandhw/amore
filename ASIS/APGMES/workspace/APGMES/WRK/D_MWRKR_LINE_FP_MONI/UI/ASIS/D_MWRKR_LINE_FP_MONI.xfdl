    <Script type="xscript5.0"><![CDATA[/*************************   Program description   ****************************
 File Name      : D_MWRKR_LINE_FP_MONI
 File Desc.     : 
 Author         : LGT
 Create Date    : 2023/01/10
 Change History :
*******************************************************************************/

/*****************************
 *  공통 Script Include      *
 ****************************/
include "js::MES_COMMON.xjs"

/***************************************************************************************************
 *                                   화면 공통 Event 처리 부분                                    *
 ***************************************************************************************************/
this.Form_onload = function(obj:Form, e:nexacro.LoadEventInfo)
{
	this.gfn_FormLoadSetting(obj);
	this.gfn_GridSetting(this);
	
	//Document Title 설정
	
	// 화면 권한 체크 (버튼 활성,비활성 설정)
	this.gfn_CommL3AuthChk(true,"4");
	 
	this.gfn_GetTranSearch(this.ds_search, "PLANT|LANG_TYPE|PROC_ID|CHNG_ID|USER_PRD_CI");
		
	//사업장 SC MU 구분 추가 2013. 01. 09 ypk
	if (this.ds_search.getColumn(0, "USER_PRD_CI")=="X")
	{
		this.ds_search.setColumn(0, "USER_PRD_CI", "SC");
	}
	
 	var sSvcNm = "";
 	var sTransition = "";
 	var sInDataSet  = "";
 	var sOutDataSet = "";
 	var sArgument = "";
 	
 	//작업그룹
	sSvcNm = "MGENS_CONT-service"; 
	sTransition = "find01";              
	sInDataSet  = "";
	sOutDataSet = "ds_combo3=dsr_SearchListResult01";
	sArgument = "PLANT="+application.g_ds_Session.getColumn(0,"PLANT")+" USER_PRD_CI="+application.g_ds_Session.getColumn(0,"USER_PRD_CI")+" MNU_PAC_CI='P'";
	this.gfn_Transaction(this, "WRK_AREA", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack");	
	 	
 	//포장F/P 항목
	sSvcNm = "PGENS_CODE-service";
	sTransition = "find02";
	sOutDataSet = "ds_SearchListResult042_Row=dsr_SearchListResult";
	sArgument = "CODE_TYPE=042"
	           + this.gfn_GetTranInfo("PLANT|LANG_TYPE");
	this.gfn_Transaction(this, "code042", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);

	//포장F/P 모니터링 라인
	sSvcNm = "D_MGENS_FP_MONI_SET-service";
	sTransition = "find02";
	sOutDataSet = "ds_SearchListResult043_Row=dsr_SearchListResult";
	sArgument = "CODE_TYPE=043"
	           + this.gfn_GetTranInfo("PLANT|LANG_TYPE")
	           + this.gfn_ParamSetting("PRD_CI", this.ds_search.getColumn(0, "USER_PRD_CI"));
	this.gfn_Transaction(this, "code043", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);
	
	//포장F/P 모니터링 작업장(별칭)
	sSvcNm = "D_MGENS_FP_MONI_SET-service";
	sTransition = "find02";
	sOutDataSet = "ds_SearchListResult044_Row=dsr_SearchListResult";
	sArgument = "CODE_TYPE=044"
	           + this.gfn_GetTranInfo("PLANT|LANG_TYPE")
	           + this.gfn_ParamSetting("PRD_CI", this.ds_search.getColumn(0, "USER_PRD_CI"));
	this.gfn_Transaction(this, "code044", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);
	
	//EPS 연동구분
	sSvcNm = "PGENS_CODE-service";
	sTransition = "find02";
	sOutDataSet = "ds_SearchListResult045_Row=dsr_SearchListResult";
	sArgument = "CODE_TYPE=045"
	           + this.gfn_GetTranInfo("PLANT|LANG_TYPE");
	this.gfn_Transaction(this, "code045", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);

	// 조회
	//this.button1.click();
	this.vscrollbar.set_pos(0); // 2024.06.19 LJD FORM스크롤 상단이동
}

// 조회
this.button1_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
	this.ds_datagrid_main.clearData();
	
	var sSvcNm = "D_MWRKR_LINE_FP_MONI-service"; 
	var sTransition = "find";              
	var sInDataSet  = "";
	var sOutDataSet = "ds_datagrid_main=dsr_SearchListResult01";
	var sArgument = this.gfn_GetTranInfo("PLANT|LANG_TYPE")
	              + this.gfn_ParamSetting("PRD_CI", this.ds_search.getColumn(0, "USER_PRD_CI"));
	this.gfn_Transaction(this, "find_main", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);
}

// 종료
this.button5_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
	this.gfn_Button5(this.value_change_flag);
}

// 포장 F/P 설정
this.button6_onclick = function(obj:Button,  e:nexacro.ClickEventInfo)
{
	this.gfn_OpenPopup( "D_MGENS_FP_MONI_SET"
					  , "GEN::D_MGENS_FP_MONI_SET.xfdl"
					  , { PLANT:application.g_ds_Session.getColumn( 0, "PLANT" )
					     ,PRD_CI:this.radio1.value},"" );
}

/***************************************************************************************************
 *                                 화면 공통 Function 처리 부분                                  *
 ***************************************************************************************************/
this.fn_CallBack = function (sSvcID, nErrorCode, sErrorMsg)
{
	//transaction Error 처리
	if(!this.gfn_CheckTranResult(this, sSvcID, nErrorCode, sErrorMsg)) return;
	
	switch(this.gfn_GetSvcId(sSvcID))//get service id 
	{
	
		case "code042" :
		
			break;
			
		case "code043" :
		
			break;
			
		case "code044" :
		
			for (var row=0; row<this.ds_SearchListResult044_Row.rowcount; row++)
			{
				this.all["titleName"+(row+1)].set_text(this.ds_SearchListResult044_Row.getColumn(row, "CODE_KOR_NAME"));
			}
			
			var sSvcNm = "D_MWRKR_LINE_FP_MONI-service"; 
			var sTransition = "find_head";              
			var sInDataSet  = "";
			var sOutDataSet = "ds_headSet=dsr_SearchListResult01";
			var sArgument = this.gfn_GetTranInfo("PLANT|LANG_TYPE")
			              + this.gfn_ParamSetting("PRD_CI", this.ds_search.getColumn(0, "USER_PRD_CI"));
			this.gfn_Transaction(this, "find_head", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);
		
			break;
			
		case "find_main" :
			
			this.ds_datagrid01.clearData();
			this.ds_datagrid02.clearData();
			this.ds_datagrid03.clearData();
			this.ds_datagrid04.clearData();
			this.ds_datagrid05.clearData();
			this.ds_datagrid06.clearData();
			
			if(this.ds_search.getColumn(0, "USER_PRD_CI")=="SC")
			{
				this.ds_datagrid_main.filter("SEQ == '001'")
				this.ds_datagrid01.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '002'")
				this.ds_datagrid02.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '003'")
				this.ds_datagrid03.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '004'")
				this.ds_datagrid04.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '005'")
				this.ds_datagrid05.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '006'")
				this.ds_datagrid06.copyData(this.ds_datagrid_main , true);
			}
			else
			{
				this.ds_datagrid_main.filter("SEQ == '007'")
				this.ds_datagrid01.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '008'")
				this.ds_datagrid02.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '009'")
				this.ds_datagrid03.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '010'")
				this.ds_datagrid04.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '011'")
				this.ds_datagrid05.copyData(this.ds_datagrid_main , true);
				this.ds_datagrid_main.filter("SEQ == '012'")
				this.ds_datagrid06.copyData(this.ds_datagrid_main , true);	
			}
			
			//this.fn_expression();
		
			break;
			
		case "find_head" :
			
			var sSvcNm = "D_MWRKR_LINE_FP_MONI-service"; 
			var sTransition = "find_row_cnt";              
			var sInDataSet  = "";
			var sOutDataSet = "ds_body_cnt=dsr_SearchListResult01";
			var sArgument = this.gfn_GetTranInfo("PLANT|LANG_TYPE")
			              + this.gfn_ParamSetting("PRD_CI", this.ds_search.getColumn(0, "USER_PRD_CI"));
			this.gfn_Transaction(this, "find_body_cnt", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);
		
			break;
			
		case "find_body_cnt" :
		
			// 그리드 헤더 세팅
			// 2024.06.19 LJD 그리드 로딩 속도 개선 
			this.datagrid1.set_enableredraw(false);
			this.datagrid2.set_enableredraw(false);
			this.datagrid3.set_enableredraw(false);
			this.datagrid4.set_enableredraw(false);
			this.datagrid5.set_enableredraw(false);
			this.datagrid6.set_enableredraw(false);
						
			this.gridExpD();
			this.gridExpC();
			this.gridExpB();
			
			this.fn_expression();
			
			this.datagrid1.set_enableredraw(true);
			this.datagrid2.set_enableredraw(true);
			this.datagrid3.set_enableredraw(true);
			this.datagrid4.set_enableredraw(true);
			this.datagrid5.set_enableredraw(true);
			this.datagrid6.set_enableredraw(true);			
		
			break;
		
		case "find4" :
			
			break;
			
		default:
		
			break;
	}
}
/***************************************************************************************************
 *                                사용자 정의  Function 처리 부분                                  *
 ***************************************************************************************************/
