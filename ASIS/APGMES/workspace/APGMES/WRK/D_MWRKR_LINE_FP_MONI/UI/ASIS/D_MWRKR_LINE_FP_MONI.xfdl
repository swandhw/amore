	{	
		if(this.ds_headSet.getColumn(i, "COMM_CODE") == "001" || this.ds_headSet.getColumn(i, "COMM_CODE") == "007")
		{
			A1 = A1+1;
			
			this.datagrid1.set_autofittype("none");
			
			var insertidx = this.datagrid1.appendContentsCol();
			//var insertidx2 = this.datagrid1.appendContentsCol();
			
			this.datagrid1.setCellProperty("head", insertidx , "color", "black");
			//this.datagrid1.setCellProperty("head", insertidx2 , "color", "black");
			
			this.datagrid1.setCellProperty("head", insertidx , "text", this.ds_headSet.getColumn(i, "CODE_KOR_ABR"));
			//this.datagrid1.setCellProperty("head", insertidx2 , "text", "상태");
			
