//=========================================================================================================
// 그리드 헤더 동적삭제
//=========================================================================================================
this.gridExpD = function()
{
	for(var i = 0 ; i < 6 ; i++)
	{
		for(var j = 6 ; j < 40 ; j++){
			this.all["datagrid"+(i+1)].deleteContentsCol("Head", 7);
		}		
	}
}

//=========================================================================================================
// 그리드 바디 동적생성
//=========================================================================================================
this.gridExpB = function()
{
	var iPosition    = 122;  // 리사이징을 위한 기준값 변경시 디자인 확인 필요
	var iSumHeight   = 0;    // 전체 길이 계산
	var iSumTop      = 0;    // 전체 길이 계산
	var iTop         = 100;  // 전체 길이 계산
	
	for(var i = 0 ; i < this.ds_body_cnt.rowcount ; i++)
	{	
		if(this.ds_body_cnt.getColumn(i, "COMM_CODE") == "001" || this.ds_body_cnt.getColumn(i, "COMM_CODE") == "007")
		{
			iSumHeight = 40 + iSumHeight + 70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 );
			
			this.datagrid1.set_height(70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 ));
			
			this.datagrid1.set_autofittype("none");
		}
		
		if(this.ds_body_cnt.getColumn(i, "COMM_CODE") == "002" || this.ds_body_cnt.getColumn(i, "COMM_CODE") == "008")
		{
			iSumTop = iTop + iSumHeight;
			
			this.titleName2.set_top(iSumTop);
			
			this.datagrid2.set_top(iSumTop + 24);
			
			if(this.ds_body_cnt.getColumn(i, "ROW_CNT") != 0)
			{
				iSumHeight = 40 + iSumHeight + 70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 );
								
				this.datagrid2.set_height(70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 ));
			}
			else
			{
				iSumHeight = iSumHeight + 106;
				this.datagrid2.set_height(76);
			}
			
			this.datagrid2.set_autofittype("none");
		}
		
		if(this.ds_body_cnt.getColumn(i, "COMM_CODE") == "003" || this.ds_body_cnt.getColumn(i, "COMM_CODE") == "009")
		{
			iSumTop = iTop + iSumHeight;
			
			this.titleName3.set_top(iSumTop);
			
			this.datagrid3.set_top(iSumTop + 24);

			if(this.ds_body_cnt.getColumn(i, "ROW_CNT") != 0)
			{
				iSumHeight = 40 + iSumHeight + 70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 );
								
				this.datagrid3.set_height(70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 ));
			}
			else
			{
				iSumHeight = iSumHeight + 106;
				this.datagrid3.set_height(76);
			}
			
			this.datagrid3.set_autofittype("none");
		}
		
		if(this.ds_body_cnt.getColumn(i, "COMM_CODE") == "004" || this.ds_body_cnt.getColumn(i, "COMM_CODE") == "010")
		{
			iSumTop = iTop + iSumHeight;
			
			this.titleName4.set_top(iSumTop);
			
			this.datagrid4.set_top(iSumTop + 24);
			
			if(this.ds_body_cnt.getColumn(i, "ROW_CNT") != 0)
			{
				iSumHeight = 40 + iSumHeight + 70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 );
								
				this.datagrid4.set_height(70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 ));
			}
			else
			{
				iSumHeight = iSumHeight + 106;
				this.datagrid4.set_height(76);
			}
			
			this.datagrid4.set_autofittype("none");
		}
		
		if(this.ds_body_cnt.getColumn(i, "COMM_CODE") == "005" || this.ds_body_cnt.getColumn(i, "COMM_CODE") == "011")
		{
			iSumTop = iTop + iSumHeight;
			
			this.titleName5.set_top(iSumTop);
			
			this.datagrid5.set_top(iSumTop + 24);
						
			if(this.ds_body_cnt.getColumn(i, "ROW_CNT") != 0)
			{
				iSumHeight = 40 + iSumHeight + 70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 );
								
				this.datagrid5.set_height(70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 ));
			}
			else
			{
				iSumHeight = iSumHeight + 106;
				this.datagrid5.set_height(76);
			}
			
			this.datagrid5.set_autofittype("none");
		}
		
		if(this.ds_body_cnt.getColumn(i, "COMM_CODE") == "006" || this.ds_body_cnt.getColumn(i, "COMM_CODE") == "012")
		{
			iSumTop = iTop + iSumHeight;
				
			this.titleName6.set_top(iSumTop);
				
			this.datagrid6.set_top(iSumTop + 24);
		
			if(this.ds_body_cnt.getColumn(i, "ROW_CNT") != 0)
			{
				iSumHeight = 40 + iSumHeight + 70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 );
								
				this.datagrid6.set_height(70 + ( this.ds_body_cnt.getColumn(i, "ROW_CNT") * 24 ));
			}
			else
			{
				iSumHeight = iSumHeight + 106;
				this.datagrid6.set_height(76);
			}
	
			this.datagrid6.set_autofittype("none");				
		}
	}
}

/***************************************************************************************************
 *                                  사용자 정의  Event 처리 부분                                   *
 ***************************************************************************************************/
this.radio1_onitemchanged = function(obj:Radio, e:nexacro.ItemChangeEventInfo)
{
	this.ds_datagrid01.clearData();
	this.ds_datagrid02.clearData();
	this.ds_datagrid03.clearData();
	this.ds_datagrid04.clearData();
	this.ds_datagrid05.clearData();
	this.ds_datagrid06.clearData();
			
	this.ds_SearchListResult043_Row.clearData();
	this.ds_SearchListResult044_Row.clearData();
	
	//포장F/P 모니터링 라인
	var sSvcNm = "D_MGENS_FP_MONI_SET-service";
	var sTransition = "find02";
	var sInDataSet  = "";
	var sOutDataSet = "ds_SearchListResult043_Row=dsr_SearchListResult";
	var sArgument = "CODE_TYPE=043"
	              + this.gfn_GetTranInfo("PLANT|LANG_TYPE")
	              + this.gfn_ParamSetting("PRD_CI", this.ds_search.getColumn(0, "USER_PRD_CI"));
	this.gfn_Transaction(this, "code043", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);
	
	//포장F/P 모니터링 작업장(별칭)
	var sSvcNm = "D_MGENS_FP_MONI_SET-service";
	var sTransition = "find02";
	var sInDataSet  = "";
	var sOutDataSet = "ds_SearchListResult044_Row=dsr_SearchListResult";
	var sArgument = "CODE_TYPE=044"
	              + this.gfn_GetTranInfo("PLANT|LANG_TYPE")
	              + this.gfn_ParamSetting("PRD_CI", this.ds_search.getColumn(0, "USER_PRD_CI"));
	this.gfn_Transaction(this, "code044", sTransition, sSvcNm ,sInDataSet, sOutDataSet, sArgument, "fn_CallBack", true,false,false);
}
